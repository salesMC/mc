# =====================================================================
#  MC Transportation — environment settings (TEMPLATE)
#  Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#  Railway needs the same keys under the service's "Variables" tab.
# =====================================================================


# ---------------------------------------------------------------------
#  1. SERVER
# ---------------------------------------------------------------------
# Port the website listens on locally (Railway sets its own automatically)
PORT=3000

# Public address of the website. Used to build the links inside emails
# (pickup-confirmation link). Example: https://mcships.com
APP_URL=


# ---------------------------------------------------------------------
#  2. DATABASE  (MySQL)
#  Stores orders, customers, users, promo codes, listings, settings.
# ---------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=


# ---------------------------------------------------------------------
#  3. STRIPE  (card payments)
#  Website checkout charges + phone-quote card holds / no-show fees.
#  Stripe Dashboard → Developers → API keys
#    pk_live_ / sk_live_  = REAL money
#    pk_test_ / sk_test_  = test mode (card 4242 4242 4242 4242)
# ---------------------------------------------------------------------
# Publishable key — safe to appear in the browser
STRIPE_PUBLISHABLE_KEY=
# Secret key — server only, never share
STRIPE_SECRET_KEY=


# ---------------------------------------------------------------------
#  4. GOOGLE MAPS  (address autocomplete + mileage)
#  Used on: shipping calculator, checkout, admin phone-quote wizard,
#  shipper "post a load" form. Browser key — restrict it in Google Cloud:
#    • HTTP referrers → your domain (+ localhost:3000/* for testing)
#    • APIs → Maps JavaScript API, Places API, Distance Matrix API
# ---------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=


# ---------------------------------------------------------------------
#  5. EMAIL  (outgoing mail via SMTP)
#  Sends the pickup-confirmation link, the customer receipt, and admin
#  notices. Leave SMTP_HOST empty to turn email off.
#
#  Resend (recommended): SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=<Resend API key>
#  Gmail:                SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<App Password>
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender customers see, e.g.  MC Transportation <sales@mcships.com>
MAIL_FROM=
# Optional: your address, emailed when a customer confirms or a hold expires
ADMIN_NOTIFY_EMAIL=


# ---------------------------------------------------------------------
#  6. SECURITY / LOGIN
# ---------------------------------------------------------------------
# Signs login cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Login email + password for the auto-created admin account (first run only)
ADMIN_EMAIL=
ADMIN_DEFAULT_PASSWORD=
# true = create demo carrier/shipper accounts + sample listings (dev only)
SEED_DEMO_DATA=false


# ---------------------------------------------------------------------
#  7. AWS S3  (file storage: vehicle photos, invoices, BOLs, attachments)
#  Leave AWS_S3_BUCKET empty to store files on the local disk instead.
#  AWS Console → S3 → your bucket name;  IAM → user → access keys.
#  The bucket stays private — the site serves files through /uploads/.
# ---------------------------------------------------------------------
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------
#  3b. STRIPE WEBHOOK  (keeps orders in sync with refunds/disputes made in Stripe)
#  Stripe Dashboard → Developers → Webhooks → Add endpoint
#    URL: https://mcships.com/api/stripe/webhook
#    Events: charge.refunded, payment_intent.canceled, payment_intent.succeeded,
#            charge.dispute.created, charge.dispute.closed
#  Then copy the "Signing secret" (whsec_...) here.
# ---------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
#  8. GMAIL SENDING  (customer emails leave from a real Gmail account so they
#  land in the Primary tab). Google Cloud -> APIs & Services -> Credentials ->
#  OAuth client ID (Web application), redirect URI:
#    https://mcships.com/admin/gmail/callback
#  Then connect the account once at /admin/email.
# ---------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
