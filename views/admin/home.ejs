<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("_head", { title: "Home" }) %>
</head>
<body data-page="home">
  <%- include("_nav", { page: "home" }) %>
  <main class="relative mx-auto px-3 sm:px-6 lg:px-8 py-8 md:py-10" style="max-width: 1500px;">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-6">
      <div>
        <h2 class="text-3xl font-bold text-white">Today</h2>
        <p id="homeDate" class="text-dim text-sm mt-1"></p>
      </div>
      <div class="flex gap-2">
        <button onclick="openCustomerWizard()" class="btn btn-primary"><i class="fas fa-plus"></i> New quote</button>
        <button onclick="loadDashboard()" class="btn btn-cyan"><i class="fas fa-sync-alt"></i> Refresh</button>
      </div>
    </div>

    <div id="homeStats" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3 mb-8"></div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <div class="tile" id="homePickups"></div>
      <div class="tile" id="homeHolds"></div>
      <div class="tile xl:col-span-2" id="homeQuotes"></div>
      <div class="tile" id="homeAwaiting"></div>
      <div class="tile xl:col-span-2" id="homeRecent"></div>
    </div>
  </main>
  <%- include("_modals") %>
  <%- include("_foot") %>
</body>
</html>
