<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("_head", { title: "Signed agreement " + order.id }) %>
  <style>
    .doc { max-width: 820px; margin: 0 auto; }
    .doc-row { display: grid; grid-template-columns: 180px 1fr; gap: 8px 16px; padding: 6px 0; border-bottom: 1px dashed var(--line); font-size: 0.9rem; }
    .doc-row .k { color: var(--ink-muted); }
    .clause-list { counter-reset: c; }
    .clause-list li { counter-increment: c; position: relative; padding-left: 2.2rem; margin-bottom: 0.9rem; line-height: 1.6; }
    .clause-list li::before { content: counter(c); position: absolute; left: 0; top: 0.1rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; border: 1px solid var(--line); font-size: 0.75rem; display: flex; align-items: center; justify-content: center; color: var(--orange); font-weight: 700; }
    @media print {
      body { background: #fff !important; color: #111 !important; }
      .no-print { display: none !important; }
      .tile, .doc-row, .clause-list li::before { border-color: #bbb !important; }
      .tile { background: #fff !important; box-shadow: none !important; }
      .text-white, .text-dim, .text-muted, strong { color: #111 !important; }
      .doc-row .k { color: #555 !important; }
      a { color: #111 !important; text-decoration: none; }
    }
  </style>
</head>
<body>
  <%
    const a = agreement || {};
    const c = (a.order && a.order.contact) || order.contact || {};
    const loc = (a.order && a.order.location) || order.location || {};
    const vehicles = (a.order && a.order.vehicles) || order.vehicles || (order.vehicle ? [order.vehicle] : []);
    const au = a.authorization || null;
    const fmt = d => d ? new Date(d).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
  %>

  <div class="no-print">
    <%- include("_nav", { page: "orders" }) %>
  </div>

  <main class="doc px-4 py-8 md:py-12">
    <div class="no-print flex flex-wrap items-center justify-between gap-3 mb-6">
      <a href="/admin/orders?open=<%= encodeURIComponent(order.id) %>" class="text-dim hover:text-white text-sm"><i class="fas fa-arrow-left mr-1"></i> Back to order</a>
      <div class="flex gap-2">
        <button onclick="window.print()" class="btn btn-primary px-5 py-2.5"><i class="fas fa-print"></i> Print / Save as PDF</button>
      </div>
    </div>

    <div class="tile p-8 md:p-10">
      <div class="flex items-start justify-between gap-4 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xl font-bold tracking-tight text-white">MC</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--orange)]"></span>
            <span class="text-[10px] tracking-[0.22em] uppercase text-[var(--ink-muted)] font-medium pt-0.5">Transportation</span>
          </div>
          <h1 class="text-2xl font-bold text-white">Vehicle Pickup Agreement</h1>
          <p class="text-dim text-sm mt-1">Order <span class="font-mono text-orange-400"><%= order.id %></span> · Agreement version <%= a.version || '—' %></p>
        </div>
        <% if (a.agreedAt) { %>
          <span class="pay-pill pay-paid" style="margin-left:0;font-size:0.75rem;padding:6px 12px">Signed</span>
        <% } else { %>
          <span class="pay-pill pay-wait" style="margin-left:0;font-size:0.75rem;padding:6px 12px">Not signed yet</span>
        <% } %>
      </div>

      <% if (!a.agreedAt) { %>
        <p class="text-dim">The customer has not accepted the agreement for this order yet. Once they do, every detail of what they agreed to is recorded here.</p>
      <% } else { %>

      <h2 class="font-semibold text-white mb-3">Signature</h2>
      <div class="mb-8">
        <div class="doc-row"><div class="k">Signed by (typed name)</div><div class="text-white font-semibold text-lg" style="font-family: Georgia, 'Times New Roman', serif; font-style: italic;"><%= a.agreedName %></div></div>
        <div class="doc-row"><div class="k">Date &amp; time</div><div class="text-white"><%= fmt(a.agreedAt) %></div></div>
        <div class="doc-row"><div class="k">IP address</div><div class="text-white"><%= a.ip || '—' %></div></div>
        <div class="doc-row"><div class="k">Device / browser</div><div class="text-white text-xs break-all"><%= a.userAgent || '—' %></div></div>
        <div class="doc-row"><div class="k">Email link sent to</div><div class="text-white"><%= c.email || '—' %></div></div>
      </div>

      <h2 class="font-semibold text-white mb-3">Card authorization</h2>
      <div class="mb-8">
        <% if (au) { %>
          <div class="doc-row"><div class="k">Card</div><div class="text-white"><%= au.card ? (au.card.brand || '').toUpperCase() + ' •••• ' + au.card.last4 + ' (exp ' + au.card.expMonth + '/' + au.card.expYear + ')' : 'on file' %></div></div>
          <div class="doc-row"><div class="k">Hold placed</div><div class="text-white"><%= money(au.amount) %> on <%= fmt(au.authorizedAt) %></div></div>
          <div class="doc-row"><div class="k">Hold valid until</div><div class="text-white"><%= fmt(au.holdExpiresAt) %></div></div>
          <div class="doc-row"><div class="k">Stripe reference</div><div class="text-white font-mono text-xs"><%= au.paymentIntentId %></div></div>
        <% } else { %>
          <p class="text-dim text-sm">Agreement was signed but the card authorization did not complete.</p>
        <% } %>
        <% if (order.chargedAt) { %>
          <div class="doc-row"><div class="k">Charged</div><div class="text-white"><%= money(order.chargedAmount) %> on <%= fmt(order.chargedAt) %><%= order.paymentStatus === 'fee_charged' ? ' (no-show fee)' : '' %></div></div>
        <% } %>
        <% if (order.refundedAmount) { %>
          <div class="doc-row"><div class="k">Refunded</div><div class="text-white"><%= money(order.refundedAmount) %> on <%= fmt(order.refundedAt) %></div></div>
        <% } %>
      </div>

      <h2 class="font-semibold text-white mb-3">What was agreed</h2>
      <div class="mb-8">
        <div class="doc-row"><div class="k">Customer</div><div class="text-white"><%= c.fullName || '—' %><%= c.company ? ' · ' + c.company : '' %></div></div>
        <div class="doc-row"><div class="k">Phone / email</div><div class="text-white"><%= c.phone || '—' %> · <%= c.email || '—' %></div></div>
        <div class="doc-row"><div class="k">Vehicle(s)</div><div class="text-white">
          <% vehicles.forEach(v => { %><div><%= [v.year, v.make, v.model].filter(Boolean).join(' ') || 'Vehicle' %><%= v.vin ? ' · VIN ' + v.vin : '' %><%= v.condition === 'inoperable' ? ' · inoperable' : '' %></div><% }) %>
        </div></div>
        <div class="doc-row"><div class="k">Pickup</div><div class="text-white"><%= loc.pickup || '—' %></div></div>
        <div class="doc-row"><div class="k">Delivery</div><div class="text-white"><%= loc.delivery || '—' %></div></div>
        <div class="doc-row"><div class="k">First pickup date</div><div class="text-white"><%= (a.order && a.order.pickupDate) || order.pickupDate || '—' %></div></div>
        <div class="doc-row"><div class="k">Transport price</div><div class="text-white font-semibold"><%= money(a.amount != null ? a.amount : order.total) %></div></div>
        <div class="doc-row"><div class="k">No-show / dry-run fee</div><div class="text-white font-semibold"><%= money(a.noShowFee != null ? a.noShowFee : order.noShowFee) %></div></div>
      </div>

      <h2 class="font-semibold text-white mb-3">Agreement text as shown to the customer</h2>
      <ol class="clause-list text-sm text-dim">
        <% (a.clauses || []).forEach(cl => { %><li><%= cl %></li><% }) %>
      </ol>

      <p class="text-xs text-muted mt-8">
        This record was created automatically when the customer typed their name, ticked the acceptance box and authorized their card on the MC Transportation confirmation page. The agreement text above is the exact wording displayed at that time. Questions: <%= phone %>.
      </p>
      <% } %>
    </div>
  </main>

  <%- include("_foot") %>
</body>
</html>
