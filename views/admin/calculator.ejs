<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("_head", { title: "Calculator Settings" }) %>
</head>
<body data-page="calculator">

  <%- include("_nav", { page: "calculator" }) %>

  <main class="relative max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-8 md:py-10">
    <!-- ==================== CALCULATOR SETTINGS ==================== -->
    <div class="tile" id="sec-calculator">
      <div class="flex flex-wrap justify-between items-center mb-8 gap-4 orders-header">
        <h2 class="text-3xl font-bold text-white flex items-center gap-3">
          <i class="fas fa-calculator"></i>
          Calculator Settings
        </h2>
      </div>

      <div id="calculatorContent">
        <div class="mb-8">
          <label class="label-dark mb-3">Base Fee ($)</label>
          <input id="baseFee" type="number" value="120" class="input-admin text-2xl">
        </div>

        <div class="mb-10">
          <div class="flex justify-between items-center mb-6">
            <div><h3 class="text-xl font-semibold text-white">Rate per mile by distance</h3><p class="text-xs text-muted mt-1">The rate blends smoothly between these points, so a 2,900-mile run is priced near the last rate and a 150-mile run between the first two. No jumps.</p></div>
            <button onclick="addTier()" class="btn btn-cyan text-sm">
              <i class="fas fa-plus"></i> Add Tier
            </button>
          </div>
          <table class="w-full">
            <thead>
              <tr class="text-left text-muted border-b border-[var(--line)]">
                <th class="pb-4">At this many miles</th>
                <th class="pb-4">Rate per Mile ($)</th>
                <th class="pb-4 w-12"></th>
              </tr>
            </thead>
            <tbody id="tiersBody"></tbody>
          </table>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6 calc-grid-3">
          <div>
            <label class="label-dark">Sedan / Compact SUV</label>
            <input id="multSedan" type="number" step="0.01" value="1.00" class="input-admin">
          </div>
          <div>
            <label class="label-dark">Mid-size SUV</label>
            <input id="multMid" type="number" step="0.01" value="1.10" class="input-admin">
          </div>
          <div>
            <label class="label-dark">Full-size SUV</label>
            <input id="multFull" type="number" step="0.01" value="1.20" class="input-admin">
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-10">
          <div>
            <label class="label-dark">Pick-up Truck</label>
            <input id="multPickup" type="number" step="0.01" value="1.15" class="input-admin">
          </div>
          <div>
            <label class="label-dark">Cargo Van</label>
            <input id="multCargoVan" type="number" step="0.01" value="1.25" class="input-admin">
          </div>
          <div>
            <label class="label-dark">Passenger Van</label>
            <input id="multPassengerVan" type="number" step="0.01" value="1.25" class="input-admin">
          </div>
          <div>
            <label class="label-dark">Mini Van</label>
            <input id="multMiniVan" type="number" step="0.01" value="1.00" class="input-admin">
          </div>
          <div>
            <label class="label-dark">Other</label>
            <input id="multOther" type="number" step="0.01" value="1.20" class="input-admin">
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-10 calc-grid-3">
          <div>
            <label class="label-dark">Inoperable</label>
            <input id="addonInop" type="number" value="75" class="input-admin">
          </div>
          <div>
            <label class="label-dark">Modified / Custom</label>
            <input id="addonMod" type="number" value="100" class="input-admin">
          </div>
          <div>
            <label class="label-dark">Urgent Delivery</label>
            <input id="addonUrgent" type="number" value="100" class="input-admin">
          </div>
        </div>

        <div class="flex gap-3 calc-btn-row">
          <button onclick="saveConfig()" class="flex-1 btn btn-primary py-5">
            <i class="fas fa-save"></i> Save base rates
          </button>
          <button onclick="resetConfig()" class="flex-1 btn btn-ghost py-5">
            <i class="fas fa-rotate-left"></i> Reset base rates to market defaults
          </button>
        </div>
      </div>
    </div>

    <!-- ==================== MARKET PRICING ==================== -->
    <div class="tile mt-8" id="sec-pricing">
      <div class="mb-6">
        <h2 class="text-3xl font-bold text-white flex items-center gap-3"><i class="fas fa-chart-line"></i> Market pricing</h2>
        <p class="text-dim text-sm mt-2">Layers applied on top of the base rates above. Fuel updates itself weekly; season and timing follow the calendar; the market dial is yours. Customers only ever see the final total.</p>
      </div>
      <div id="pricingSection"><p class="text-muted text-sm"><i class="fas fa-circle-notch fa-spin mr-1"></i> Loading…</p></div>
    </div>

    <!-- ==================== LOCATION RATINGS ==================== -->
    <div class="tile mt-8" id="sec-locations">
      <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
        <div>
          <h2 class="text-2xl font-bold text-white flex items-center gap-3"><i class="fas fa-location-dot"></i> Location ratings</h2>
          <p class="text-dim text-sm mt-1">Every address that has been quoted, with the tier the engine gave it. Override one if it's wrong, and every future quote for that address uses your tier.</p>
        </div>
        <input id="locSearch" type="search" placeholder="Search address…" class="input-admin w-64" oninput="loadLocationRatings()">
      </div>
      <div id="locationRatings"><p class="text-muted text-sm">Loading…</p></div>
    </div>

    <!-- ==================== VEHICLE WEIGHTS ==================== -->
    <div class="tile mt-8" id="sec-weights">
      <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
        <div>
          <h2 class="text-2xl font-bold text-white flex items-center gap-3"><i class="fas fa-weight-hanging"></i> Vehicle weights</h2>
          <p class="text-dim text-sm mt-1">Every model that has been quoted, with the curb weight the engine uses for the heavy-vehicle surcharge. Type a number to correct one; clear it to go back to the looked-up value.</p>
        </div>
        <input id="weightSearch" type="search" placeholder="Search make or model…" class="input-admin w-64" oninput="loadVehicleWeights()">
      </div>
      <div id="vehicleWeights"><p class="text-muted text-sm">Loading…</p></div>
    </div>
  </main>

  <%- include("_modals") %>
  <%- include("_foot") %>
</body>
</html>
