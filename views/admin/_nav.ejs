<%# Admin top bar. Expects `page` = 'orders' | 'customers' | 'promo-codes' | 'calculator' %>
<%
  const adminLinks = [
    ['orders',      '/admin/orders',      'fa-clipboard-list', 'Orders'],
    ['payments',    '/admin/payments',    'fa-credit-card',    'Payments'],
    ['customers',   '/admin/customers',   'fa-users',          'Customers'],
    ['leads',       '/admin/leads',       'fa-envelope-open-text', 'Leads'],
    ['promo-codes', '/admin/promo-codes', 'fa-tag',            'Promo Codes'],
    ['calculator',  '/admin/calculator',  'fa-calculator',     'Calculator'],
  ];
%>
<nav class="admin-nav">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <a href="/admin/orders" class="flex items-center gap-2 flex-shrink-0">
      <span class="text-xl font-bold tracking-tight text-white">MC</span>
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--orange)] mx-1"></span>
      <span class="text-[10px] tracking-[0.22em] uppercase text-[var(--ink-muted)] font-medium pt-0.5">Admin</span>
    </a>

    <div class="hidden md:flex items-center gap-1">
      <% adminLinks.forEach(([key, href, icon, label]) => { %>
        <a href="<%= href %>" class="admin-nav-link <%= page === key ? 'active' : '' %>">
          <i class="fas <%= icon %> mr-1.5"></i><%= label %>
        </a>
      <% }) %>
    </div>

    <!-- Global search: any order or customer, from any page, opens in place -->
    <div class="relative flex-1 max-w-md hidden sm:block" id="globalSearchWrap">
      <i class="fas fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-muted text-xs pointer-events-none"></i>
      <input id="globalSearch" type="search" placeholder="Search orders, customers, VIN, phone…  (press /)"
             autocomplete="off" class="input-admin text-sm py-2 pl-9 pr-3"
             oninput="globalSearchInput()" onfocus="globalSearchInput()" onkeydown="globalSearchKey(event)">
      <div id="globalSearchResults" class="hidden absolute left-0 right-0 mt-2 rounded-xl border border-[var(--line)] shadow-2xl overflow-hidden z-50" style="background:#161B22;max-height:70vh;overflow-y:auto"></div>
    </div>

    <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
      <button type="button" onclick="openPasswordModal()" class="admin-nav-link" title="Change your password">
        <i class="fas fa-user-gear mr-1.5"></i><span id="adminNavEmail" class="hidden lg:inline text-xs truncate max-w-[200px]">Account</span>
      </button>
      <a href="/" target="_blank" class="admin-nav-link" title="Open the public website in a new tab">
        <i class="fas fa-arrow-up-right-from-square mr-1.5"></i><span class="hidden sm:inline">View site</span>
      </a>
      <button type="button" onclick="adminLogout()" class="admin-nav-link admin-nav-logout">
        <i class="fas fa-right-from-bracket mr-1.5"></i><span class="hidden sm:inline">Log out</span>
      </button>
    </div>
  </div>

  <!-- Mobile page links -->
  <div class="md:hidden border-t border-[var(--line)] px-3 py-2 flex gap-1 overflow-x-auto" style="scrollbar-width:none;">
    <% adminLinks.forEach(([key, href, icon, label]) => { %>
      <a href="<%= href %>" class="admin-nav-link <%= page === key ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </div>
</nav>
