<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { title: 'Sign in' }) %>
</head>
<body>

  <div class="min-h-screen relative overflow-hidden flex items-center justify-center px-4 py-12">
    <div class="glow-orange" style="top: -140px; right: -100px;"></div>
    <div class="glow-cyan" style="bottom: -120px; left: -80px;"></div>

    <div class="relative w-full max-w-md">
      <div class="text-center mb-10">
        <a href="/" class="inline-flex items-center gap-2 mb-8">
          <span class="text-2xl font-bold tracking-tight text-white">MC</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--orange)] mx-1"></span>
          <span class="text-[11px] tracking-[0.22em] uppercase text-[var(--ink-muted)] font-medium pt-0.5">Transportation</span>
        </a>
        <div class="w-14 h-14 mx-auto mb-6 rounded-xl flex items-center justify-center text-[var(--orange)]"
             style="background: rgba(255,106,61,0.12); border: 1px solid rgba(255,106,61,0.3);">
          <i class="fas fa-right-to-bracket"></i>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight">Welcome back</h1>
        <p class="text-dim mt-3">Sign in to access the admin panel</p>
      </div>

      <div class="tile p-8 md:p-10">
        <form id="signInForm" onsubmit="return false" class="space-y-5">
          <div>
            <label class="label-dark">Email</label>
            <input id="signInEmail" type="email" placeholder="you@example.com" class="input-dark" required autocomplete="username">
          </div>
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="label-dark mb-0">Password</label>
              <button type="button" onclick="toggleForgot(true)" class="text-xs text-[var(--cyan)] hover:text-white transition-colors">Forgot password?</button>
            </div>
            <input id="passwordInput" type="password" placeholder="••••••••" class="input-dark" required autocomplete="current-password">
          </div>

          <label class="flex items-center gap-3 cursor-pointer text-sm text-dim select-none">
            <input type="checkbox" id="rememberMe" class="w-4 h-4" style="accent-color: var(--orange);">
            Keep me signed in for 30 days
          </label>

          <p id="passwordError" class="hidden text-sm text-red-400 flex items-center gap-2">
            <i class="fas fa-circle-exclamation"></i>
            <span>Incorrect email or password.</span>
          </p>

          <button type="button" onclick="checkPassword()"
                  class="btn btn-primary w-full py-4 text-base font-semibold">
            Sign In
          </button>
        </form>

        <!-- Forgot password -->
        <form id="forgotForm" onsubmit="return false" class="hidden space-y-5">
          <p class="text-sm text-dim">Enter the email you sign in with and we'll send a link to choose a new password.</p>
          <div>
            <label class="label-dark">Email</label>
            <input id="forgotEmail" type="email" placeholder="you@example.com" class="input-dark" autocomplete="username">
          </div>
          <p id="forgotMsg" class="hidden text-sm"></p>
          <button type="button" onclick="sendReset()" class="btn btn-primary w-full py-4 text-base font-semibold">Send reset link</button>
          <button type="button" onclick="toggleForgot(false)" class="w-full text-sm text-dim hover:text-white transition-colors"><i class="fas fa-arrow-left mr-1"></i> Back to sign in</button>
        </form>
      </div>

      <p class="text-center text-xs text-muted mt-8">
        <a href="/" class="hover:text-white transition-colors"><i class="fas fa-arrow-left mr-1"></i> Back to website</a>
      </p>
    </div>
  </div>

  <script>
    // Where to go after login: ?next=/admin/... (set by the auth guard) or Orders
    const nextUrl = (() => {
      const n = new URLSearchParams(location.search).get('next') || '';
      return n.startsWith('/admin/') ? n : '/admin/home';
    })();

    // Already signed in (valid admin cookie) → straight to the dashboard
    fetch('/api/auth/me').then(r => r.json()).then(me => {
      if (me.authenticated && me.role === 'admin') {
        sessionStorage.setItem('mcAdminAuth', '1');
        sessionStorage.setItem('mcAdminEmail', me.email);
        window.location.replace(nextUrl);
      } else {
        sessionStorage.removeItem('mcAdminAuth');
        sessionStorage.removeItem('mcAdminEmail');
      }
    }).catch(() => {});

    // Older builds kept the password in localStorage; wipe that if present.
    try { localStorage.removeItem('mcAdminRemember'); } catch (e) {}
    // Remember only the email (never the password); "Keep me signed in" is a server-side 30-day session.
    try { document.getElementById('signInEmail').value = localStorage.getItem('mcAdminEmail') || ''; } catch (e) {}

    async function checkPassword() {
      const email = document.getElementById('signInEmail').value.trim();
      const pw    = document.getElementById('passwordInput').value;
      const remember = document.getElementById('rememberMe').checked;
      const err   = document.getElementById('passwordError');
      const btn   = document.querySelector('#signInForm button.btn');
      err.classList.add('hidden');
      btn.disabled = true;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password: pw, role: 'admin', remember })
        });
        const data = await res.json();

        if (data.success) {
          sessionStorage.setItem('mcAdminAuth', '1');
          sessionStorage.setItem('mcAdminEmail', data.email);
          try { localStorage.setItem('mcAdminEmail', email); } catch (e) {}
          window.location.href = nextUrl;
        } else {
          err.querySelector('span').textContent = data.message || 'Incorrect email or password.';
          err.classList.remove('hidden');
        }
      } catch (e) {
        err.querySelector('span').textContent = 'Connection error. Please try again.';
        err.classList.remove('hidden');
      } finally {
        btn.disabled = false;
      }
    }

    function toggleForgot(show) {
      document.getElementById('signInForm').classList.toggle('hidden', show);
      document.getElementById('forgotForm').classList.toggle('hidden', !show);
      if (show) {
        document.getElementById('forgotEmail').value = document.getElementById('signInEmail').value.trim();
        document.getElementById('forgotMsg').classList.add('hidden');
        document.getElementById('forgotEmail').focus();
      }
    }

    async function sendReset() {
      const email = document.getElementById('forgotEmail').value.trim();
      const msg = document.getElementById('forgotMsg');
      const btn = document.querySelector('#forgotForm button.btn');
      if (!email) { msg.textContent = 'Enter your email first.'; msg.className = 'text-sm text-red-400'; return; }
      btn.disabled = true;
      try {
        const res = await fetch('/api/auth/forgot', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
        const data = await res.json();
        msg.textContent = data.message || (data.success ? 'Check your inbox for the reset link.' : 'Could not send the link. Try again.');
        msg.className = 'text-sm ' + (data.success ? 'text-lime-400' : 'text-red-400');
      } catch (e) {
        msg.textContent = 'Connection error. Please try again.'; msg.className = 'text-sm text-red-400';
      } finally { btn.disabled = false; }
    }

    ['signInEmail', 'passwordInput'].forEach(id => {
      document.getElementById(id).addEventListener('keypress', (e) => { if (e.key === 'Enter') checkPassword(); });
    });
    document.getElementById('forgotEmail').addEventListener('keypress', (e) => { if (e.key === 'Enter') sendReset(); });
  </script>
</body>
</html>
