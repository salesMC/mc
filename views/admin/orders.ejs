<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("_head", { title: "Orders" }) %>
</head>
<body data-page="orders">

  <%- include("_nav", { page: "orders" }) %>

  <main class="relative max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-8 md:py-10">
    <!-- ==================== ORDERS SECTION ==================== -->
    <div class="tile" id="sec-orders">
      <div class="flex flex-wrap justify-between items-center mb-8 gap-4 orders-header">
        <h2 class="text-3xl font-bold text-white flex items-center gap-3">
          <i class="fas fa-clipboard-list"></i> 
          Orders / Quotes
        </h2>
        <button onclick="loadOrders()" class="btn btn-cyan flex items-center gap-2">
          <i class="fas fa-sync-alt"></i> Refresh
        </button>
      </div>

      <!-- Search + filters -->
      <div class="flex flex-wrap items-center gap-2 mb-5">
        <input id="ordersSearch" type="search" placeholder="Search order #, name, email, phone, VIN, vehicle, address…"
               class="input-admin flex-1 min-w-[240px]" oninput="ordersFilterChanged()">
        <select id="ordersStatus" class="input-admin w-auto" onchange="ordersFilterChanged()">
          <option value="">All statuses</option>
          <option value="New">New</option>
          <option value="In Work">In Work</option>
          <option value="Done">Done</option>
          <option value="Canceled">Canceled</option>
        </select>
        <select id="ordersPayment" class="input-admin w-auto" onchange="ordersFilterChanged()">
          <option value="">All payments</option>
          <option value="unpaid">No card yet</option>
          <option value="pending">Awaiting card</option>
          <option value="holding">On hold · not charged</option>
          <option value="charged">Charged</option>
          <option value="partially_refunded">Partly refunded</option>
          <option value="refunded">Refunded</option>
          <option value="fee_charged">No-show fee charged</option>
          <option value="released">Released</option>
          <option value="expired">Hold expired</option>
        </select>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th>Order</th>
              <th>Customer</th>
              <th class="col-hide-mobile">Vehicle</th>
              <th class="text-right">Total</th>
              <th>Status</th>
              <th>Payment</th>
              <th class="w-24 text-center"></th>
            </tr>
          </thead>
          <tbody id="ordersBody" class="text-dim"></tbody>
        </table>
      </div>

      <div id="noOrdersMessage" class="hidden text-center py-16 text-muted">
        <i class="fas fa-inbox text-6xl mb-6 opacity-40"></i>
        <p>No orders match</p>
      </div>
      <div id="ordersPager" class="pager"></div>
    </div>
  </main>

  <%- include("_modals") %>
  <%- include("_foot") %>
</body>
</html>
