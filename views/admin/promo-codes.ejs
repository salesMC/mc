<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("_head", { title: "Promo Codes" }) %>
</head>
<body data-page="promo-codes">

  <%- include("_nav", { page: "promo-codes" }) %>

  <main class="relative max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-8 md:py-10">
    <!-- ==================== PROMO CODES SECTION ==================== -->
    <div class="tile" id="sec-promos">
      <div class="flex flex-wrap justify-between items-center mb-8 gap-4 orders-header">
        <h2 class="text-3xl font-bold text-white flex items-center gap-3">
          <i class="fas fa-tag"></i>
          Promo Codes
        </h2>
        <button onclick="loadPromoCodes()" class="btn btn-cyan flex items-center gap-2">
          <i class="fas fa-sync-alt"></i> Refresh
        </button>
      </div>

      <div id="promosContent">

        <!-- Add new promo code -->
        <div class="bg-[var(--bg-deep)] border border-[var(--line)] rounded-xl p-5 mb-6">
          <h3 class="text-lg font-semibold text-white mb-4">Add New Promo Code</h3>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <div class="sm:col-span-1">
              <label class="label-dark">Code</label>
              <input id="newPromoCode" type="text" placeholder="SAVE20" class="input-admin uppercase"
                     oninput="this.value=this.value.toUpperCase()">
            </div>
            <div>
              <label class="label-dark">Discount</label>
              <input id="newPromoDiscount" type="number" step="0.01" min="0" placeholder="20" class="input-admin">
            </div>
            <div>
              <label class="label-dark">Type</label>
              <select id="newPromoType" class="input-admin">
                <option value="percent">% Percent</option>
                <option value="fixed">$ Fixed</option>
              </select>
            </div>
            <div class="flex items-end">
              <button onclick="addPromoCode()" class="btn btn-primary w-full py-3">
                <i class="fas fa-plus"></i> Add Code
              </button>
            </div>
          </div>
        </div>

        <!-- Promo codes table -->
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr>
                <th>Code</th>
                <th>Discount</th>
                <th>Type</th>
                <th>Status</th>
                <th class="text-center w-32">Actions</th>
              </tr>
            </thead>
            <tbody id="promoCodesBody" class="text-dim"></tbody>
          </table>
        </div>

        <div id="noPromosMessage" class="hidden text-center py-10 text-muted">
          <i class="fas fa-tag text-4xl mb-4 opacity-40"></i>
          <p>No promo codes yet</p>
        </div>
      </div>
    </div>
  </main>

  <%- include("_modals") %>
  <%- include("_foot") %>
</body>
</html>
