<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("_head", { title: "Payments" }) %>
</head>
<body data-page="payments">

  <%- include("_nav", { page: "payments" }) %>

  <main class="relative mx-auto px-3 sm:px-6 lg:px-8 py-8 md:py-10" style="max-width: 1500px;">
    <div class="tile payments-tile" id="sec-payments">
      <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
        <div>
          <h2 class="text-3xl font-bold text-white flex items-center gap-3">
            <i class="fas fa-credit-card"></i> Payments
          </h2>
          <p class="text-dim text-sm mt-2">Card holds, charges and refunds for every order. Money is only taken when you click <strong class="text-white">Charge</strong>.</p>
        </div>
        <button onclick="loadPayments()" class="btn btn-cyan flex items-center gap-2">
          <i class="fas fa-sync-alt"></i> Refresh
        </button>
      </div>

      <!-- Totals -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
        <div class="pay-stat"><div class="pay-stat-label">Waiting on customers</div><div id="payTotalPending" class="pay-stat-value text-amber-300">$0</div></div>
        <div class="pay-stat"><div class="pay-stat-label">On hold (not charged)</div><div id="payTotalHolding" class="pay-stat-value text-cyan-300">$0</div></div>
        <div class="pay-stat"><div class="pay-stat-label">Charged</div><div id="payTotalCharged" class="pay-stat-value text-lime-300">$0</div></div>
        <div class="pay-stat"><div class="pay-stat-label">Refunded</div><div id="payTotalRefunded" class="pay-stat-value text-white">$0</div></div>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap items-center gap-2 mb-5">
        <div class="flex flex-wrap gap-1">
          <button data-pay-filter="all"      onclick="setPaymentsFilter('all')"      class="pay-filter active">All</button>
          <button data-pay-filter="pending"  onclick="setPaymentsFilter('pending')"  class="pay-filter">Pending</button>
          <button data-pay-filter="holding"  onclick="setPaymentsFilter('holding')"  class="pay-filter">Holding</button>
          <button data-pay-filter="charged"  onclick="setPaymentsFilter('charged')"  class="pay-filter">Charged</button>
          <button data-pay-filter="refunded" onclick="setPaymentsFilter('refunded')" class="pay-filter">Refunded</button>
          <button data-pay-filter="other"    onclick="setPaymentsFilter('other')"    class="pay-filter">Released / Expired</button>
        </div>
        <input id="paymentsSearch" oninput="paymentsSearchChanged()" type="search" placeholder="Search order, name, email, vehicle…"
               class="input-admin ml-auto w-full sm:w-72">
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th>Order</th>
              <th>Customer</th>
              <th class="col-hide-mobile">Vehicle</th>
              <th>Status</th>
              <th>Amount</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="paymentsBody" class="text-dim"></tbody>
        </table>
      </div>

      <div id="noPaymentsMessage" class="hidden text-center py-16 text-muted">
        <i class="fas fa-credit-card text-6xl mb-6 opacity-40"></i>
        <p>Nothing here</p>
      </div>
      <div id="paymentsPager" class="pager"></div>

      <details class="mt-8 text-xs text-muted">
        <summary class="cursor-pointer select-none inline-flex items-center gap-2 text-dim hover:text-white"><i class="fas fa-circle-question"></i> What do the statuses mean?</summary>
        <div class="mt-3 leading-loose pl-1">
        <span class="pay-pill pay-wait" style="margin-left:4px">Awaiting card</span> confirmation emailed, customer hasn't authorized yet ·
        <span class="pay-pill pay-hold">On hold · not charged</span> money reserved on the card, not taken. <strong class="text-dim">Charge</strong> at pickup, or <strong class="text-dim">Release</strong> if the pickup is off (customer pays nothing, no Stripe fee) ·
        <span class="pay-pill pay-paid">Charged</span> money collected, Stripe keeps ~3% even if refunded later ·
        <span class="pay-pill pay-fee">No-show fee charged</span> only the agreed fee was taken ·
        <span class="pay-pill pay-released">Released · $0</span> hold cancelled, nothing charged ·
        <span class="pay-pill pay-unpaid">Hold expired</span> 7 days passed with no action, send a new confirmation.
        </div>
      </details>
    </div>
  </main>

  <%- include("_modals") %>
  <%- include("_foot") %>
</body>
</html>
