<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('admin/_head', { title: 'Choose a new password' }) %>
</head>
<body>

  <div class="min-h-screen relative overflow-hidden flex items-center justify-center px-4 py-12">
    <div class="glow-orange" style="top: -140px; right: -100px;"></div>
    <div class="glow-cyan" style="bottom: -120px; left: -80px;"></div>

    <div class="relative w-full max-w-md">
      <div class="text-center mb-10">
        <a href="/" class="inline-flex items-center gap-2 mb-8">
          <span class="text-2xl font-bold tracking-tight text-white">MC</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--orange)] mx-1"></span>
          <span class="text-[11px] tracking-[0.22em] uppercase text-[var(--ink-muted)] font-medium pt-0.5">Transportation</span>
        </a>
        <div class="w-14 h-14 mx-auto mb-6 rounded-xl flex items-center justify-center text-[var(--orange)]"
             style="background: rgba(255,106,61,0.12); border: 1px solid rgba(255,106,61,0.3);">
          <i class="fas fa-key"></i>
        </div>
        <h1 class="text-3xl font-bold text-white tracking-tight">Choose a new password</h1>
        <p class="text-dim mt-3">At least 8 characters.</p>
      </div>

      <div class="tile p-8 md:p-10">
        <form id="resetForm" onsubmit="return false" class="space-y-5">
          <div>
            <label class="label-dark">New password</label>
            <input id="pw1" type="password" class="input-dark" autocomplete="new-password" minlength="8" required>
          </div>
          <div>
            <label class="label-dark">Repeat new password</label>
            <input id="pw2" type="password" class="input-dark" autocomplete="new-password" minlength="8" required>
          </div>
          <p id="resetMsg" class="hidden text-sm"></p>
          <button type="button" onclick="submitReset()" id="resetBtn" class="btn btn-primary w-full py-4 text-base font-semibold">Save password</button>
        </form>
        <div id="resetDone" class="hidden text-center">
          <p class="text-lime-400 text-lg font-semibold mb-2"><i class="fas fa-circle-check mr-2"></i>Password updated</p>
          <p class="text-dim text-sm mb-6">You're signed in. Taking you to your dashboard…</p>
        </div>
      </div>

      <p class="text-center text-xs text-muted mt-8">
        <a href="/admin" class="hover:text-white transition-colors"><i class="fas fa-arrow-left mr-1"></i> Back to sign in</a>
      </p>
    </div>
  </div>

  <script>
    const TOKEN = <%- JSON.stringify(token) %>;
    const redirects = { admin: '/admin/orders', carrier: '/exchange/listings', shipper: '/exchange/shipments' };
    async function submitReset() {
      const a = document.getElementById('pw1').value, b = document.getElementById('pw2').value;
      const msg = document.getElementById('resetMsg'), btn = document.getElementById('resetBtn');
      msg.classList.add('hidden');
      if (a.length < 8) { msg.textContent = 'Use at least 8 characters.'; msg.className = 'text-sm text-red-400'; return; }
      if (a !== b) { msg.textContent = 'The two passwords do not match.'; msg.className = 'text-sm text-red-400'; return; }
      btn.disabled = true;
      try {
        const res = await fetch('/api/auth/reset', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token: TOKEN, password: a }) });
        const data = await res.json();
        if (data.success) {
          document.getElementById('resetForm').classList.add('hidden');
          document.getElementById('resetDone').classList.remove('hidden');
          setTimeout(() => { window.location.href = redirects[data.role] || '/'; }, 1500);
        } else {
          msg.textContent = data.message || 'Could not reset the password.'; msg.className = 'text-sm text-red-400';
        }
      } catch (e) {
        msg.textContent = 'Connection error. Please try again.'; msg.className = 'text-sm text-red-400';
      } finally { btn.disabled = false; }
    }
    ['pw1', 'pw2'].forEach(id => document.getElementById(id).addEventListener('keypress', e => { if (e.key === 'Enter') submitReset(); }));
  </script>
</body>
</html>
