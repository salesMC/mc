<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In | MC Transportation</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    .role-tabs { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0; margin-bottom: 1.5rem; }
    .role-tab {
      padding: 0.7rem 0.5rem; text-align: center;
      font-size: 0.8rem; font-weight: 600; cursor: pointer;
      border: 1px solid var(--line); background: transparent;
      color: var(--ink-muted); transition: all 0.18s;
    }
    .role-tab:first-child { border-radius: 0.5rem 0 0 0.5rem; }
    .role-tab:last-child { border-radius: 0 0.5rem 0.5rem 0; border-left: none; }
    .role-tab:not(:first-child):not(:last-child) { border-left: none; border-radius: 0; }
    .role-tab.active {
      background: rgba(255,106,61,0.12);
      border-color: rgba(255,106,61,0.4);
      color: var(--orange);
    }
    .role-tab:not(.active):hover { color: white; border-color: var(--line-soft); }
  </style>
</head>
<body>

  <%- include('partials/header') %>

  <main class="relative overflow-hidden min-h-[80vh] flex items-center py-20">
    <div class="glow-orange" style="top: -100px; left: -80px;"></div>
    <div class="glow-cyan" style="bottom: -100px; right: -80px;"></div>

    <div class="relative max-w-md mx-auto px-6 lg:px-8 w-full">

      <div class="text-center mb-10">
        <div class="w-14 h-14 mx-auto mb-6 rounded-xl flex items-center justify-center text-[var(--orange)]" style="background: rgba(255,106,61,0.12); border: 1px solid rgba(255,106,61,0.3);">
          <i class="fas fa-right-to-bracket"></i>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight">Welcome back</h1>
        <p class="text-dim mt-3">Sign in to manage your shipments and loads.</p>
      </div>

      <div class="tile p-8 md:p-10">
        <div class="role-tabs" id="roleTabs">
          <button type="button" class="role-tab active" data-role="carrier">
            <i class="fas fa-truck block mb-1"></i> Carrier
          </button>
          <button type="button" class="role-tab" data-role="shipper">
            <i class="fas fa-box block mb-1"></i> Shipper
          </button>
          <button type="button" class="role-tab" data-role="admin">
            <i class="fas fa-shield-halved block mb-1"></i> Admin
          </button>
        </div>

        <form id="signInForm" class="space-y-5">
          <div>
            <label class="label-dark">Email</label>
            <input id="signInEmail" type="email" placeholder="you@example.com" required class="input-dark" autocomplete="username">
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="label-dark mb-0">Password</label>
              <button type="button" onclick="toggleForgot(true)" class="text-xs text-[var(--cyan)] hover:text-white transition-colors">Forgot password?</button>
            </div>
            <input id="signInPassword" type="password" placeholder="••••••••" required class="input-dark" autocomplete="current-password">
          </div>

          <label class="flex items-center gap-3 cursor-pointer text-sm text-dim select-none">
            <input type="checkbox" id="rememberMe" class="w-4 h-4" style="accent-color: var(--orange);">
            Keep me signed in for 30 days
          </label>

          <div id="signInError" class="hidden text-sm text-red-400 flex items-center gap-2">
            <i class="fas fa-circle-exclamation"></i>
            <span id="signInErrorText">Incorrect email or password.</span>
          </div>

          <button type="submit" id="signInBtn" class="btn btn-primary w-full justify-center py-4">
            Sign In as <span id="signInRoleLabel">Carrier</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"/></svg>
          </button>
        </form>

        <!-- Forgot password -->
        <form id="forgotForm" class="hidden space-y-5" onsubmit="return false">
          <p class="text-sm text-dim">Enter the email you sign in with and we'll send a link to choose a new password.</p>
          <div>
            <label class="label-dark">Email</label>
            <input id="forgotEmail" type="email" placeholder="you@example.com" class="input-dark" autocomplete="username">
          </div>
          <p id="forgotMsg" class="hidden text-sm"></p>
          <button type="button" onclick="sendReset()" id="forgotBtn" class="btn btn-primary w-full justify-center py-4">Send reset link</button>
          <button type="button" onclick="toggleForgot(false)" class="w-full text-sm text-dim hover:text-white transition-colors"><i class="fas fa-arrow-left mr-1"></i> Back to sign in</button>
        </form>

        <div id="registerBlock">
          <div class="flex items-center gap-3 my-7">
            <div class="flex-1 h-px bg-[var(--line)]"></div>
            <span class="text-xs text-muted uppercase tracking-wider">or</span>
            <div class="flex-1 h-px bg-[var(--line)]"></div>
          </div>
          <p class="text-center text-sm text-dim">
            Carrier or shipper without an account?
            <a href="/register" class="text-[var(--orange)] hover:text-white transition-colors font-medium">Create one</a>
          </p>
        </div>
      </div>

      <script>
        (function () {
          let selectedRole = 'carrier';
          const form = document.getElementById('signInForm');
          const emailField = document.getElementById('signInEmail');
          const pwField = document.getElementById('signInPassword');
          const errEl = document.getElementById('signInError');
          const errText = document.getElementById('signInErrorText');
          const roleLabel = document.getElementById('signInRoleLabel');
          const btn = document.getElementById('signInBtn');

          const redirects = {
            carrier: '/exchange/listings',
            shipper: '/exchange/shipments',
            admin:   '/admin/orders'
          };

          // Already signed in (valid cookie) → go straight to the right place
          fetch('/api/auth/me').then(r => r.json()).then(me => {
            if (me.authenticated && redirects[me.role]) window.location.replace(redirects[me.role]);
          }).catch(() => {});

          // Remember only the email typed last time (never the password)
          try { emailField.value = localStorage.getItem('mcSignInEmail') || ''; } catch (e) {}

          document.querySelectorAll('.role-tab').forEach(tab => {
            tab.addEventListener('click', () => {
              selectedRole = tab.dataset.role;
              document.querySelectorAll('.role-tab').forEach(t => t.classList.remove('active'));
              tab.classList.add('active');
              roleLabel.textContent = selectedRole.charAt(0).toUpperCase() + selectedRole.slice(1);
              document.getElementById('registerBlock').classList.toggle('hidden', selectedRole === 'admin');
            });
          });

          window.toggleForgot = function (show) {
            form.classList.toggle('hidden', show);
            document.getElementById('forgotForm').classList.toggle('hidden', !show);
            document.getElementById('registerBlock').classList.toggle('hidden', show || selectedRole === 'admin');
            if (show) {
              document.getElementById('forgotEmail').value = emailField.value.trim();
              document.getElementById('forgotMsg').classList.add('hidden');
              document.getElementById('forgotEmail').focus();
            }
          };

          window.sendReset = async function () {
            const email = document.getElementById('forgotEmail').value.trim();
            const msg = document.getElementById('forgotMsg');
            const fbtn = document.getElementById('forgotBtn');
            if (!email) { msg.textContent = 'Enter your email first.'; msg.className = 'text-sm text-red-400'; return; }
            fbtn.disabled = true;
            try {
              const res = await fetch('/api/auth/forgot', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
              const data = await res.json();
              msg.textContent = data.message || (data.success ? 'Check your inbox for the reset link.' : 'Could not send the link. Try again.');
              msg.className = 'text-sm ' + (data.success ? 'text-lime-400' : 'text-red-400');
            } catch (err) {
              msg.textContent = 'Connection error. Please try again.'; msg.className = 'text-sm text-red-400';
            } finally { fbtn.disabled = false; }
          };
          document.getElementById('forgotEmail').addEventListener('keypress', (e) => { if (e.key === 'Enter') sendReset(); });

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errEl.classList.add('hidden');
            btn.disabled = true;

            try {
              const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  email: emailField.value.trim(),
                  password: pwField.value,
                  role: selectedRole,
                  remember: document.getElementById('rememberMe').checked
                })
              });
              const data = await res.json();
              try { localStorage.setItem('mcSignInEmail', emailField.value.trim()); } catch (e2) {}

              if (data.success) {
                if (selectedRole === 'admin' || data.role === 'admin') {
                  sessionStorage.setItem('mcAdminAuth', '1');
                  sessionStorage.setItem('mcAdminEmail', data.email);
                  sessionStorage.removeItem('mcAuth');
                  sessionStorage.removeItem('mcRole');
                  window.location.href = '/admin/orders';
                } else {
                  sessionStorage.setItem('mcAuth', '1');
                  sessionStorage.setItem('mcRole', data.role);
                  sessionStorage.setItem('mcEmail', data.email);
                  sessionStorage.removeItem('mcAdminAuth');
                  window.location.href = redirects[selectedRole];
                }
              } else {
                errText.textContent = data.message || 'Incorrect email or password.';
                errEl.classList.remove('hidden');
                pwField.focus();
              }
            } catch (err) {
              errText.textContent = 'Connection error. Please try again.';
              errEl.classList.remove('hidden');
            } finally {
              btn.disabled = false;
            }
          });
        })();
      </script>

      <p class="text-center text-xs text-muted mt-8">
        By signing in you agree to our Terms &amp; Privacy Policy.
      </p>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
