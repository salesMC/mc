<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shipper Dashboard | MC Exchange</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    .stat-tile { text-align: center; }
    .stat-num { font-size: 1.75rem; font-weight: 700; color: white; line-height: 1.2; }
    .stat-label { font-size: 0.75rem; color: var(--ink-muted); margin-top: 0.35rem; }
    .stat-link {
      display: inline-block; margin-top: 0.65rem; font-size: 0.78rem; font-weight: 600;
      color: var(--cyan); transition: color 0.15s;
    }
    .stat-link:hover { color: white; }

    .shipment-card {
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: 1.5rem;
      align-items: center;
    }
    .route-city { font-weight: 600; font-size: 0.95rem; color: white; }
    .route-sub { font-size: 0.75rem; color: var(--ink-muted); margin-top: 0.15rem; }
    .status-badge {
      display: inline-block; padding: 0.25rem 0.65rem; border-radius: 9999px;
      font-size: 0.75rem; font-weight: 600;
    }
    .badge-available { background: rgba(34,211,238,0.12); color: var(--cyan); border: 1px solid rgba(34,211,238,0.3); }
    .badge-booked { background: rgba(255,106,61,0.12); color: var(--orange); border: 1px solid rgba(255,106,61,0.3); }
    .badge-in_progress { background: rgba(251,191,36,0.12); color: #FBBF24; border: 1px solid rgba(251,191,36,0.3); }
    .badge-delivered { background: rgba(167,139,250,0.12); color: var(--purple); border: 1px solid rgba(167,139,250,0.3); }
    .badge-completed, .badge-done { background: rgba(190,242,100,0.12); color: var(--lime); border: 1px solid rgba(190,242,100,0.3); }
    .badge-default { background: rgba(255,255,255,0.05); color: var(--ink-muted); border: 1px solid var(--line); }

    .shipment-actions { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; flex-wrap: wrap; }
    .btn-delete-ex {
      width: 34px; height: 34px; border-radius: 0.4rem;
      border: 1px solid var(--line-soft); background: transparent;
      color: var(--ink-dim); cursor: pointer; transition: all 0.15s;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .btn-delete-ex:hover { border-color: #f87171; color: #f87171; background: rgba(248,113,113,0.08); }
    .btn-delete-ex:disabled { opacity: 0.4; cursor: not-allowed; }

    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th {
      text-align: left; padding: 0.75rem 1rem; font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted);
      border-bottom: 1px solid var(--line); background: rgba(255,255,255,0.02);
      white-space: nowrap;
    }
    .data-table td {
      padding: 0.9rem 1rem; border-bottom: 1px solid var(--line);
      vertical-align: middle; font-size: 0.875rem;
    }
    .data-table tr:hover td { background: rgba(255,106,61,0.05); }
    .data-table .mono { font-family: ui-monospace, monospace; font-size: 0.8rem; color: var(--orange); }

    .modal-overlay {
      position: fixed; inset: 0; z-index: 100;
      background: rgba(0,0,0,0.75); backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center; padding: 1rem;
    }
    .modal-overlay.hidden { display: none; }
    .modal-box {
      background: var(--bg-panel); border: 1px solid var(--line);
      border-radius: 0.875rem; width: 100%; max-width: 560px;
      max-height: 90vh; overflow-y: auto;
    }
    .modal-box.modal-wide { max-width: 920px; }
    .detail-card {
      background: var(--bg); border: 1px solid var(--line);
      border-radius: 0.75rem; overflow: hidden;
    }
    .detail-card-head {
      background: rgba(255,106,61,0.1); border-bottom: 1px solid var(--line);
      padding: 0.65rem 1rem; font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange);
    }
    .detail-card-head.cyan { background: rgba(34,211,238,0.08); color: var(--cyan); }
    .detail-card-body { padding: 1rem; font-size: 0.875rem; color: var(--ink-dim); line-height: 1.55; }
    .detail-card-body strong { color: white; font-weight: 600; }
    .detail-meta { color: var(--ink-muted); font-size: 0.8rem; }
    .vehicle-detail-row {
      display: grid; grid-template-columns: 1.4fr 1fr 1fr auto;
      gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line);
    }
    .vehicle-detail-row:last-child { border-bottom: none; }
    .listing-clickable { cursor: pointer; transition: border-color 0.15s; }
    .listing-clickable:hover { border-color: rgba(255,106,61,0.45); }
    @media (max-width: 768px) {
      .shipment-card { grid-template-columns: 1fr; }
      .hide-md { display: none; }
      .vehicle-detail-row { grid-template-columns: 1fr; gap: 0.5rem; }
    }
  </style>
</head>
<body>

  <%- include('../partials/header') %>
  <%- include('../partials/exchange-header') %>

  <main class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-bold text-white" id="pageTitle">My Shipments</h1>
        <p class="text-sm text-muted mt-1"><span id="shipmentCount" class="text-white font-semibold">0</span> total in this view</p>
      </div>
      <div class="flex gap-3">
        <button id="postLoadBtn" class="btn btn-primary py-2.5 px-5 text-sm">
          <i class="fas fa-plus mr-1.5"></i> Post
        </button>
        <a href="/calculator" class="btn btn-ghost py-2.5 px-5 text-sm">Get Quote</a>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6" id="shipperStats">
      <div class="tile p-4 stat-tile cursor-pointer" data-goto="available">
        <div class="stat-label">Available</div>
        <div class="stat-num text-cyan" id="statAvailable">—</div>
        <a href="/exchange/shipments?view=available" class="stat-link">View</a>
      </div>
      <div class="tile p-4 stat-tile cursor-pointer" data-goto="booked">
        <div class="stat-label">Booked</div>
        <div class="stat-num text-orange" id="statBooked">—</div>
        <a href="/exchange/shipments?view=booked" class="stat-link">View</a>
      </div>
      <div class="tile p-4 stat-tile cursor-pointer" data-goto="in_progress">
        <div class="stat-label">In Progress</div>
        <div class="stat-num text-purple" id="statInProgress">—</div>
        <a href="/exchange/shipments?view=in_progress" class="stat-link">View</a>
      </div>
      <div class="tile p-4 stat-tile cursor-pointer" data-goto="completed">
        <div class="stat-label">Completed</div>
        <div class="stat-num text-[var(--lime)]" id="statCompleted">—</div>
        <a href="/exchange/shipments?view=completed" class="stat-link">View</a>
      </div>
    </div>

    <!-- Extra value stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-6">
      <div class="tile p-4 stat-tile">
        <div class="stat-num" id="statTotalListings">—</div>
        <div class="stat-label">Loads Posted</div>
      </div>
      <div class="tile p-4 stat-tile">
        <div class="stat-num text-[var(--lime)]" id="statTotalValue">—</div>
        <div class="stat-label">Total Value</div>
      </div>
      <div class="tile p-4 stat-tile">
        <div class="stat-num text-cyan" id="statAvgPrice">—</div>
        <div class="stat-label">Avg Price</div>
      </div>
    </div>

    <div id="shipmentsContainer" class="space-y-3"></div>

    <div id="shipmentsEmpty" class="hidden tile text-center py-16 text-muted">
      <i class="fas fa-box-open text-3xl mb-3 opacity-30"></i>
      <p class="mb-4" id="emptyMessage">You haven't posted any shipments yet.</p>
      <button id="postLoadBtnEmpty" class="btn btn-primary">Post Your First Load</button>
    </div>
  </main>

  <!-- Load Detail Modal -->
  <div id="detailModal" class="modal-overlay hidden">
    <div class="modal-box modal-wide">
      <div class="p-5 border-b border-[var(--line)] flex justify-between items-start">
        <div>
          <h2 class="text-lg font-bold text-white" id="detailTitle">Load Details</h2>
          <p class="text-sm text-muted mt-0.5" id="detailSub">Full shipment information</p>
        </div>
        <button id="closeDetailModal" class="text-muted hover:text-white text-xl">&times;</button>
      </div>
      <div class="p-5" id="detailBody">
        <div class="text-center text-muted py-10"><i class="fas fa-spinner fa-spin mr-2"></i>Loading…</div>
      </div>
      <div class="px-5 pb-5 flex justify-end border-t border-[var(--line)] pt-4">
        <button class="btn btn-ghost" id="detailCloseBtn">Close</button>
      </div>
    </div>
  </div>

  <!-- Post Load Modal -->
  <div id="postModal" class="modal-overlay hidden">
    <div class="modal-box modal-wide">
      <div class="p-5 border-b border-[var(--line)] flex justify-between items-start">
        <div>
          <h2 class="text-lg font-bold text-white">Post Load</h2>
          <p class="text-sm text-muted mt-0.5">Make your load visible to carriers.</p>
        </div>
        <button id="closePostModal" class="text-muted hover:text-white text-xl">&times;</button>
      </div>
      <form id="postForm" class="p-5 space-y-4">
        <div>
          <label class="label-dark">Pickup Name</label>
          <input id="originCity" required class="input-dark" placeholder="e.g. Criswell Commercial">
          <input type="hidden" id="originState" value="">
        </div>
        <div>
          <label class="label-dark">Exact Pickup Address</label>
          <input id="originAddress" class="input-dark" placeholder="Start typing address…" autocomplete="off">
        </div>
        <div>
          <label class="label-dark">Destination Name</label>
          <input id="destCity" required class="input-dark" placeholder="e.g. Fernando's Yard">
          <input type="hidden" id="destState" value="">
        </div>
        <div>
          <label class="label-dark">Exact Drop-off Address</label>
          <input id="destAddress" class="input-dark" placeholder="Start typing address…" autocomplete="off">
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="label-dark mb-0">Vehicles / VIN</label>
            <button type="button" id="addVehicleBtn" class="text-xs text-cyan hover:text-white font-semibold">+ Add vehicle</button>
          </div>
          <div id="vehiclesList" class="space-y-3"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="label-dark">Price ($)</label>
            <input id="loadPrice" type="number" min="1" required class="input-dark" placeholder="1500">
          </div>
          <div>
            <label class="label-dark">Miles</label>
            <input id="loadMiles" type="number" min="1" required class="input-dark" placeholder="Auto">
            <p class="text-xs text-muted mt-1" id="milesHint">Auto-calculated via Google Maps when addresses or cities are set. Editable.</p>
          </div>
        </div>
        <div>
          <label class="label-dark">Deliver By</label>
          <input id="deliverDate" class="input-dark" placeholder="05/28/26">
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div>
            <label class="label-dark">Pickup Notes</label>
            <input id="pickupNotes" class="input-dark" placeholder="Call 1 hour before pickup">
          </div>
          <div>
            <label class="label-dark">Drop-off Notes</label>
            <input id="dropoffNotes" class="input-dark" placeholder="Call 24 hrs in advance">
          </div>
        </div>
        <div>
          <label class="label-dark">Attachments (BOL, photos, docs)</label>
          <input id="attachmentFiles" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,image/*" class="input-dark text-sm file:mr-3 file:py-1 file:px-3 file:rounded file:border-0 file:bg-orange file:text-white">
          <div id="attachmentPreview" class="text-xs text-muted mt-2 space-y-1"></div>
        </div>
        <div id="postError" class="hidden text-sm text-red-400"></div>
        <button type="submit" class="btn btn-primary w-full justify-center py-3">Publish Load</button>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script>
  (function () {
    if (sessionStorage.getItem('mcRole') !== 'shipper') {
      window.location.href = '/sign-in';
      return;
    }

    const shipperEmail = sessionStorage.getItem('mcEmail') || '';
    const params = new URLSearchParams(location.search);
    let currentView = params.get('view') || 'mine';
    const postModal = document.getElementById('postModal');
    let allShipments = [];

    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s || '';
      return d.innerHTML;
    }

    function statusBadge(status) {
      const s = (status || 'New').toLowerCase().replace(/\s+/g, '_');
      let cls = 'badge-default';
      if (['available', 'new', 'posted'].includes(s)) cls = 'badge-available';
      else if (s === 'booked') cls = 'badge-booked';
      else if (s === 'in_progress') cls = 'badge-in_progress';
      else if (s === 'delivered') cls = 'badge-delivered';
      else if (['done', 'completed', 'delivered'].includes(s)) cls = 'badge-completed';
      return `<span class="status-badge ${cls}">${esc(status || 'New')}</span>`;
    }

    function normalizeStatusKey(status) {
      const s = (status || '').toLowerCase();
      if (['available', 'new', 'posted'].includes(s)) return 'available';
      if (s === 'booked') return 'booked';
      if (s.includes('progress')) return 'in_progress';
      if (s.includes('deliver')) return 'delivered';
      if (s.includes('complete') || s === 'done') return 'completed';
      return 'available';
    }

    function openPostModal() { postModal.classList.remove('hidden'); }
    function closePostModal() { postModal.classList.add('hidden'); }

    function dash(v) { return v ? esc(String(v)) : '—'; }

    function openDetailModal(id) {
      const detailModal = document.getElementById('detailModal');
      const body = document.getElementById('detailBody');
      body.innerHTML = '<div class="text-center text-muted py-10"><i class="fas fa-spinner fa-spin mr-2"></i>Loading…</div>';
      detailModal.classList.remove('hidden');

      const fromList = (allShipments || []).find(s => String(s.id) === String(id));
      window._shipmentDocs = fromList ? {
        invoiceUrl: fromList.invoiceUrl || null,
        bolUrl: fromList.bolUrl || null
      } : {};

      fetch(`/api/exchange/listings/${encodeURIComponent(id)}`)
        .then(r => r.json())
        .then(d => {
          if (!d || !d.id) {
            body.innerHTML = '<p class="text-red-400">Could not load details.</p>';
            return;
          }
          document.getElementById('detailTitle').textContent = 'Load ' + d.id;
          document.getElementById('detailSub').textContent =
            (d.origin?.city || '') + (d.origin?.state ? ', ' + d.origin.state : '') +
            ' → ' + (d.destination?.city || '') + (d.destination?.state ? ', ' + d.destination.state : '');

          const shipper = d.shipper || {};
          const sc = d.shipperContact || {};
          const pickup = d.pickup || {};
          const dropoff = d.dropoff || {};
          const vehicles = d.vehicles || [];

          const vehicleHtml = vehicles.map(v => `
            <div class="vehicle-detail-row">
              <div>
                <div class="font-semibold text-white text-base">${dash(v.label)}</div>
                ${v.vin ? `<div class="detail-meta mt-1">VIN: <span class="text-orange font-mono text-xs">${esc(v.vin)}</span></div>` : ''}
              </div>
              <div class="text-sm text-dim space-y-0.5">
                ${v.type ? `<div>Type: ${esc(v.type)}</div>` : ''}
                ${v.condition ? `<div>Condition: ${esc(v.condition)}</div>` : ''}
                ${v.color ? `<div>Color: ${esc(v.color)}</div>` : ''}
              </div>
              <div class="text-sm text-dim space-y-0.5">
                ${v.runsAndDrives !== undefined ? `<div>Runs & drives: ${v.runsAndDrives ? 'Yes' : 'No'}</div>` : ''}
                ${v.hasKeys !== undefined ? `<div>Has keys: ${v.hasKeys ? 'Yes' : 'No'}</div>` : ''}
              </div>
              <div class="text-right">
                <div class="text-lg font-bold text-orange">$${Number(v.price || d.price || 0).toLocaleString()}</div>
              </div>
            </div>
          `).join('');

          body.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
              <div class="detail-card">
                <div class="detail-card-head">Shipper</div>
                <div class="detail-card-body">
                  <div class="font-semibold text-white mb-1">${dash(shipper.company || shipper.name || shipperEmail)}</div>
                  ${shipper.email || shipperEmail ? `<div>Email: ${esc(shipper.email || shipperEmail)}</div>` : ''}
                  ${shipper.phone ? `<div>Phone: ${esc(shipper.phone)}</div>` : ''}
                </div>
              </div>
              <div class="detail-card">
                <div class="detail-card-head cyan">Contact</div>
                <div class="detail-card-body">
                  <div class="font-semibold text-white mb-1">${dash(sc.name)}</div>
                  ${sc.phone ? `<div>Phone: ${esc(sc.phone)}</div>` : ''}
                  ${sc.email ? `<div>Email: ${esc(sc.email)}</div>` : ''}
                </div>
              </div>
              <div class="detail-card">
                <div class="detail-card-head">Pickup Location</div>
                <div class="detail-card-body">
                  <div class="font-semibold text-white mb-1">${dash(pickup.name)}</div>
                  <div>${dash(pickup.address)}</div>
                  <div class="mt-2"><span class="text-muted">Pickup ETA:</span> <strong>${dash(pickup.eta)}</strong></div>
                </div>
              </div>
              <div class="detail-card">
                <div class="detail-card-head cyan">Drop-off Location</div>
                <div class="detail-card-body">
                  <div class="font-semibold text-white mb-1">${dash(dropoff.name)}</div>
                  <div>${dash(dropoff.address)}</div>
                  <div class="mt-2"><span class="text-muted">Drop-off ETA:</span> <strong>${dash(dropoff.eta)}</strong></div>
                </div>
              </div>
            </div>
            <div class="detail-card mb-4">
              <div class="detail-card-head" style="background:rgba(190,242,100,0.08);color:var(--lime);">Vehicles</div>
              <div class="detail-card-body py-2">${vehicleHtml || '<div class="text-muted py-3">No vehicle details</div>'}</div>
            </div>
            ${Array.isArray(d.attachments) && d.attachments.length ? `
            <div class="detail-card mb-4">
              <div class="detail-card-head" style="background:rgba(167,139,250,0.1);color:var(--purple);">Attachments</div>
              <div class="detail-card-body space-y-2">
                ${d.attachments.map(a => `
                  <a href="${esc(a.url)}" target="_blank" rel="noopener" class="flex items-center gap-2 text-cyan hover:text-white text-sm">
                    <i class="fas fa-paperclip"></i>
                    <span>${esc(a.name || 'Document')}</span>
                  </a>
                `).join('')}
              </div>
            </div>` : ''}
            ${(d.invoiceUrl || d.bolUrl || (window._shipmentDocs && (window._shipmentDocs.invoiceUrl || window._shipmentDocs.bolUrl))) ? (() => {
              const inv = d.invoiceUrl || window._shipmentDocs?.invoiceUrl;
              const bol = d.bolUrl || window._shipmentDocs?.bolUrl;
              return `
            <div class="detail-card mb-4">
              <div class="detail-card-head" style="background:rgba(255,106,61,0.12);color:var(--orange);">Carrier Documents</div>
              <div class="detail-card-body space-y-2">
                ${inv ? `<a href="${esc(inv)}" target="_blank" class="flex items-center gap-2 text-cyan hover:text-white text-sm"><i class="fas fa-file-invoice"></i> Invoice</a>` : '<div class="text-muted text-sm">Invoice not uploaded yet</div>'}
                ${bol ? `<a href="${esc(bol)}" target="_blank" class="flex items-center gap-2 text-cyan hover:text-white text-sm"><i class="fas fa-file-alt"></i> BOL</a>` : '<div class="text-muted text-sm">BOL not uploaded yet</div>'}
              </div>
            </div>`;
            })() : ''}
            <div class="flex justify-between items-end">
              <div>${statusBadge(d.status)}</div>
              <div class="text-right">
                <div class="text-xs text-muted uppercase tracking-wider">Total</div>
                <div class="text-3xl font-bold text-orange">$${Number(d.total || d.price || 0).toLocaleString()}</div>
              </div>
            </div>
          `;
        })
        .catch(() => {
          body.innerHTML = '<p class="text-red-400">Connection error loading details.</p>';
        });
    }

    function closeDetailModal() {
      document.getElementById('detailModal').classList.add('hidden');
    }
    document.getElementById('closeDetailModal')?.addEventListener('click', closeDetailModal);
    document.getElementById('detailCloseBtn')?.addEventListener('click', closeDetailModal);
    document.getElementById('detailModal')?.addEventListener('click', e => {
      if (e.target.id === 'detailModal') closeDetailModal();
    });

    document.getElementById('postLoadBtn').addEventListener('click', openPostModal);
    document.getElementById('postLoadBtnEmpty')?.addEventListener('click', openPostModal);
    document.getElementById('closePostModal').addEventListener('click', closePostModal);
    postModal.addEventListener('click', e => { if (e.target === postModal) closePostModal(); });

    // —— Vehicles / VIN ——
    let vehicleRows = [];
    let pendingFiles = [];

    function renderVehicleRows() {
      const list = document.getElementById('vehiclesList');
      if (!vehicleRows.length) {
        vehicleRows = [{ vin: '', label: '', year: '', make: '', model: '' }];
      }
      list.innerHTML = vehicleRows.map((v, i) => `
        <div class="p-3 rounded-lg border border-[var(--line)] bg-[var(--bg)] space-y-2" data-v-idx="${i}">
          <div class="flex gap-2 items-end">
            <div class="flex-1">
              <label class="label-dark">VIN</label>
              <input class="input-dark vin-input" data-idx="${i}" value="${esc(v.vin)}" placeholder="17-character VIN" maxlength="17">
            </div>
            <button type="button" class="btn btn-ghost text-xs px-3 py-2 decode-btn" data-idx="${i}">Decode</button>
            ${vehicleRows.length > 1 ? `<button type="button" class="text-red-400 text-sm px-2 remove-v" data-idx="${i}">&times;</button>` : ''}
          </div>
          <div>
            <label class="label-dark">Vehicle name</label>
            <input class="input-dark label-input" data-idx="${i}" value="${esc(v.label)}" placeholder="2026 Ram 1500">
          </div>
          <div class="text-xs text-muted vin-status" data-idx="${i}"></div>
        </div>
      `).join('');

      list.querySelectorAll('.vin-input').forEach(inp => {
        inp.addEventListener('input', () => {
          const idx = Number(inp.dataset.idx);
          vehicleRows[idx].vin = inp.value.trim().toUpperCase();
          if (vehicleRows[idx].vin.length === 17) decodeVin(idx);
        });
        inp.addEventListener('blur', () => {
          const idx = Number(inp.dataset.idx);
          if (vehicleRows[idx].vin.length >= 11) decodeVin(idx);
        });
      });
      list.querySelectorAll('.label-input').forEach(inp => {
        inp.addEventListener('input', () => {
          vehicleRows[Number(inp.dataset.idx)].label = inp.value;
        });
      });
      list.querySelectorAll('.decode-btn').forEach(btn => {
        btn.addEventListener('click', () => decodeVin(Number(btn.dataset.idx)));
      });
      list.querySelectorAll('.remove-v').forEach(btn => {
        btn.addEventListener('click', () => {
          vehicleRows.splice(Number(btn.dataset.idx), 1);
          renderVehicleRows();
        });
      });
    }

    async function decodeVin(idx) {
      const vin = (vehicleRows[idx].vin || '').trim().toUpperCase();
      const status = document.querySelector(`.vin-status[data-idx="${idx}"]`);
      if (vin.length < 11) {
        if (status) status.textContent = 'Enter at least 11 characters';
        return;
      }
      if (status) status.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Looking up VIN…';
      try {
        const r = await fetch('/api/vin/' + encodeURIComponent(vin));
        const d = await r.json();
        if (d.success) {
          vehicleRows[idx].vin = vin;
          vehicleRows[idx].year = d.year || '';
          vehicleRows[idx].make = d.make || '';
          vehicleRows[idx].model = d.model || '';
          vehicleRows[idx].type = d.type || '';
          vehicleRows[idx].label = d.label || vehicleRows[idx].label;
          const labelInp = document.querySelector(`.label-input[data-idx="${idx}"]`);
          if (labelInp) labelInp.value = vehicleRows[idx].label;
          if (status) status.innerHTML = `<span class="text-lime">✓ ${esc(d.label)}</span>`;
        } else {
          if (status) status.innerHTML = `<span class="text-orange">${esc(d.message || 'Not found')}</span>`;
        }
      } catch {
        if (status) status.innerHTML = '<span class="text-red-400">Lookup failed</span>';
      }
    }

    document.getElementById('addVehicleBtn')?.addEventListener('click', () => {
      vehicleRows.push({ vin: '', label: '', year: '', make: '', model: '' });
      renderVehicleRows();
    });

    document.getElementById('attachmentFiles')?.addEventListener('change', (e) => {
      pendingFiles = Array.from(e.target.files || []);
      const prev = document.getElementById('attachmentPreview');
      prev.innerHTML = pendingFiles.map(f =>
        `<div><i class="fas fa-paperclip mr-1"></i>${esc(f.name)} <span class="text-muted">(${Math.round(f.size / 1024)} KB)</span></div>`
      ).join('') || '';
    });

    function readFileAsDataURL(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve({ name: file.name, size: file.size, data: reader.result });
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    document.getElementById('postForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const errEl = document.getElementById('postError');
      errEl.classList.add('hidden');

      const vehicles = vehicleRows
        .map(v => ({
          vin: (v.vin || '').trim().toUpperCase() || null,
          label: (v.label || '').trim() || null,
          year: v.year || null,
          make: v.make || null,
          model: v.model || null,
          type: v.type || null
        }))
        .filter(v => v.vin || v.label);

      if (!vehicles.length) {
        errEl.textContent = 'Add at least one vehicle (VIN or name).';
        errEl.classList.remove('hidden');
        return;
      }

      let attachments = [];
      try {
        attachments = await Promise.all(pendingFiles.map(readFileAsDataURL));
      } catch {
        errEl.textContent = 'Failed to read attachment files.';
        errEl.classList.remove('hidden');
        return;
      }

      const res = await fetch('/api/exchange/listings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          originCity: document.getElementById('originCity').value.trim(),
          originState: document.getElementById('originState').value.trim().toUpperCase(),
          originAddress: document.getElementById('originAddress').value.trim(),
          destCity: document.getElementById('destCity').value.trim(),
          destState: document.getElementById('destState').value.trim().toUpperCase(),
          destAddress: document.getElementById('destAddress').value.trim(),
          vehicles,
          vehicleCount: vehicles.length,
          price: Number(document.getElementById('loadPrice').value),
          miles: Number(document.getElementById('loadMiles').value),
          deliverDate: document.getElementById('deliverDate').value.trim(),
          pickupNotes: document.getElementById('pickupNotes').value.trim(),
          dropoffNotes: document.getElementById('dropoffNotes').value.trim(),
          attachments,
          shipperEmail
        })
      });
      const data = await res.json();
      if (data.success) {
        closePostModal();
        document.getElementById('postForm').reset();
        vehicleRows = [];
        pendingFiles = [];
        renderVehicleRows();
        document.getElementById('attachmentPreview').innerHTML = '';
        loadShipments();
        loadShipperStats();
      } else {
        errEl.textContent = data.message || 'Failed to publish load.';
        errEl.classList.remove('hidden');
      }
    });

    renderVehicleRows();
    document.getElementById('postLoadBtn')?.addEventListener('click', () => {
      if (!vehicleRows.length) renderVehicleRows();
    });

    // —— Auto miles via Google Maps (same approach as calculator) ——
    let fromPlace = null;
    let toPlace = null;
    let mapsReady = false;
    let distanceTimer = null;

    function setMilesHint(text, isError) {
      const el = document.getElementById('milesHint');
      if (!el) return;
      el.textContent = text;
      el.className = isError ? 'text-xs text-orange mt-1' : 'text-xs text-muted mt-1';
    }

    function buildOriginQuery() {
      if (fromPlace?.formatted_address) return fromPlace.formatted_address;
      const addr = document.getElementById('originAddress')?.value.trim();
      if (addr) return addr;
      const city = document.getElementById('originCity')?.value.trim();
      const state = document.getElementById('originState')?.value.trim();
      if (city && state) return `${city}, ${state}, USA`;
      if (city) return `${city}, USA`;
      return '';
    }

    function buildDestQuery() {
      if (toPlace?.formatted_address) return toPlace.formatted_address;
      const addr = document.getElementById('destAddress')?.value.trim();
      if (addr) return addr;
      const city = document.getElementById('destCity')?.value.trim();
      const state = document.getElementById('destState')?.value.trim();
      if (city && state) return `${city}, ${state}, USA`;
      if (city) return `${city}, USA`;
      return '';
    }

    function scheduleDistanceCalc() {
      clearTimeout(distanceTimer);
      distanceTimer = setTimeout(calculatePostDistance, 450);
    }

    function calculatePostDistance() {
      if (!mapsReady || typeof google === 'undefined' || !google.maps) return;
      const origin = buildOriginQuery();
      const dest = buildDestQuery();
      if (!origin || !dest) return;

      setMilesHint('Calculating distance…');

      const service = new google.maps.DistanceMatrixService();
      const opts = {
        origins: [fromPlace?.geometry?.location || origin],
        destinations: [toPlace?.geometry?.location || dest],
        travelMode: google.maps.TravelMode.DRIVING,
        unitSystem: google.maps.UnitSystem.IMPERIAL
      };

      service.getDistanceMatrix(opts, (response, status) => {
        if (status === 'OK' && response.rows?.[0]?.elements?.[0]?.status === 'OK') {
          const meters = response.rows[0].elements[0].distance.value;
          const miles = Math.round(meters * 0.000621371);
          const milesInput = document.getElementById('loadMiles');
          if (milesInput) milesInput.value = miles;
          setMilesHint(`Auto: ${miles.toLocaleString()} mi driving (editable)`);
        } else {
          setMilesHint('Could not calculate distance — enter miles manually.', true);
        }
      });
    }

    function initPostMapsAutocomplete() {
      if (typeof google === 'undefined' || !google.maps?.places) return;
      mapsReady = true;
      const options = { types: ['address'], componentRestrictions: { country: 'us' } };

      const originAddr = document.getElementById('originAddress');
      const destAddr = document.getElementById('destAddress');
      if (!originAddr || !destAddr) return;

      const fromAc = new google.maps.places.Autocomplete(originAddr, options);
      fromAc.addListener('place_changed', () => {
        fromPlace = fromAc.getPlace();
        if (fromPlace.address_components) {
          let state = '';
          fromPlace.address_components.forEach(c => {
            if (c.types.includes('administrative_area_level_1')) state = c.short_name;
          });
          if (state) document.getElementById('originState').value = state;
        }
        calculatePostDistance();
      });

      const toAc = new google.maps.places.Autocomplete(destAddr, options);
      toAc.addListener('place_changed', () => {
        toPlace = toAc.getPlace();
        if (toPlace.address_components) {
          let state = '';
          toPlace.address_components.forEach(c => {
            if (c.types.includes('administrative_area_level_1')) state = c.short_name;
          });
          if (state) document.getElementById('destState').value = state;
        }
        calculatePostDistance();
      });

      ['originCity', 'originState', 'destCity', 'destState'].forEach(id => {
        document.getElementById(id)?.addEventListener('change', () => {
          fromPlace = null;
          toPlace = null;
          scheduleDistanceCalc();
        });
        document.getElementById(id)?.addEventListener('blur', scheduleDistanceCalc);
      });
      originAddr.addEventListener('blur', scheduleDistanceCalc);
      destAddr.addEventListener('blur', scheduleDistanceCalc);
    }

    window.initPostGoogleMaps = function () {
      initPostMapsAutocomplete();
    };

    (function loadGoogleMaps() {
      if (window.google?.maps?.places) {
        initPostMapsAutocomplete();
        return;
      }
      if (document.getElementById('gmaps-post-script')) return;
      const script = document.createElement('script');
      script.id = 'gmaps-post-script';
      script.src = 'https://maps.googleapis.com/maps/api/js?key=<%= googleMapsKey %>&libraries=places&callback=initPostGoogleMaps';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    })();

    function filterByView(list) {
      if (currentView === 'mine' || currentView === 'all') return list;
      return list.filter(s => normalizeStatusKey(s.status) === currentView);
    }

    function loadShipments() {
      fetch(`/api/exchange/shipments?email=${encodeURIComponent(shipperEmail)}`)
        .then(r => r.json())
        .then(data => {
          allShipments = data || [];
          const filtered = filterByView(allShipments);
          document.getElementById('shipmentCount').textContent = filtered.length;
          const container = document.getElementById('shipmentsContainer');
          const empty = document.getElementById('shipmentsEmpty');

          const titles = {
            mine: 'My Shipments',
            available: 'Available Shipments',
            booked: 'Booked Shipments',
            in_progress: 'In Progress',
            completed: 'Completed Shipments'
          };
          document.getElementById('pageTitle').textContent = titles[currentView] || 'My Shipments';

          if (!filtered.length) {
            container.innerHTML = '';
            empty.classList.remove('hidden');
            document.getElementById('emptyMessage').textContent =
              currentView === 'mine'
                ? "You haven't posted any shipments yet."
                : 'No shipments in this status.';
            return;
          }
          empty.classList.add('hidden');

          container.innerHTML = filtered.map(s => `
            <div class="tile shipment-card p-5 md:p-6 listing-clickable" data-detail-id="${esc(s.id)}">
              <div class="flex items-center gap-4 min-w-0">
                <div class="min-w-0">
                  <div class="text-xs mono text-orange mb-1">${esc(s.id)}</div>
                  <div class="route-city truncate">${esc(s.origin?.city || '')}${s.origin?.state ? ', ' + esc(s.origin.state) : ''}</div>
                  <div class="route-sub">Pickup ${esc(s.pickupDate || 'TBD')}</div>
                </div>
                <span class="text-muted text-sm shrink-0"><i class="fas fa-arrow-right"></i></span>
                <div class="min-w-0">
                  <div class="route-city truncate">${esc(s.destination?.city || '')}${s.destination?.state ? ', ' + esc(s.destination.state) : ''}</div>
                  <div class="route-sub">Deliver ${esc(s.deliverDate || 'TBD')}</div>
                </div>
              </div>
              <div class="text-center">
                <div class="text-sm text-dim mb-1">${esc(s.vehicle)}</div>
                <div class="text-xl font-bold text-orange">$${Number(s.price || 0).toLocaleString()}</div>
                ${s.miles ? `<div class="text-xs text-muted mt-1">${Number(s.miles).toLocaleString()} mi</div>` : ''}
                <div class="text-xs text-cyan mt-1">View details</div>
              </div>
              <div class="shipment-actions">
                ${statusBadge(s.status)}
                ${normalizeStatusKey(s.status) === 'available' || normalizeStatusKey(s.status) === 'booked' ? `
                  <button class="btn-delete-ex" data-id="${esc(s.id)}" data-source="${esc(s.source || 'listing')}" title="Delete shipment">
                    <i class="fas fa-trash"></i>
                  </button>
                ` : ''}
              </div>
            </div>
          `).join('');

          container.querySelectorAll('[data-detail-id]').forEach(card => {
            card.addEventListener('click', (e) => {
              if (e.target.closest('.btn-delete-ex')) return;
              openDetailModal(card.dataset.detailId);
            });
          });
          container.querySelectorAll('.btn-delete-ex').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              deleteShipment(btn.dataset.id, btn.dataset.source, btn);
            });
          });

          // update nav counts from full set
          updateCounts(allShipments);
        })
        .catch(() => {
          document.getElementById('shipmentsEmpty').classList.remove('hidden');
        });
    }

    function updateCounts(list) {
      const counts = { available: 0, booked: 0, in_progress: 0, completed: 0 };
      list.forEach(s => {
        const k = normalizeStatusKey(s.status);
        if (counts[k] !== undefined) counts[k]++;
        if (k === 'delivered') counts.completed++; // roll into completed for shipper nav simplicity
      });
      document.getElementById('statAvailable').textContent = counts.available;
      document.getElementById('statBooked').textContent = counts.booked;
      document.getElementById('statInProgress').textContent = counts.in_progress;
      document.getElementById('statCompleted').textContent = counts.completed;
      if (window.updateExchangeNavCounts) {
        window.updateExchangeNavCounts({
          mine: list.length,
          available: counts.available,
          booked: counts.booked,
          in_progress: counts.in_progress,
          completed: counts.completed
        });
      }
    }

    async function deleteShipment(id, source, btn) {
      if (!confirm('Delete this shipment? This cannot be undone.')) return;
      btn.disabled = true;
      try {
        const res = await fetch(
          `/api/exchange/shipments/${encodeURIComponent(id)}?source=${encodeURIComponent(source)}&shipperEmail=${encodeURIComponent(shipperEmail)}`,
          { method: 'DELETE' }
        );
        const data = await res.json();
        if (data.success) {
          loadShipments();
          loadShipperStats();
        } else {
          alert(data.message || 'Failed to delete shipment.');
          btn.disabled = false;
        }
      } catch (e) {
        alert('Connection error while deleting.');
        btn.disabled = false;
      }
    }

    function loadShipperStats() {
      fetch(`/api/exchange/shipper-stats?email=${encodeURIComponent(shipperEmail)}`)
        .then(r => r.json())
        .then(s => {
          document.getElementById('statTotalListings').textContent = s.totalListings ?? 0;
          document.getElementById('statTotalValue').textContent = '$' + (s.totalValue || 0).toLocaleString();
          document.getElementById('statAvgPrice').textContent = '$' + (s.avgPrice || 0).toLocaleString();
        })
        .catch(() => {});
    }

    document.querySelectorAll('[data-goto]').forEach(el => {
      el.addEventListener('click', (e) => {
        if (e.target.tagName === 'A') return;
        location.href = '/exchange/shipments?view=' + el.dataset.goto;
      });
    });

    loadShipments();
    loadShipperStats();
  })();
  </script>
</body>
</html>
