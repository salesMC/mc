            ${Array.isArray(d.attachments) && d.attachments.length ? `
            <div class="detail-card mb-4">
              <div class="detail-card-head" style="background:rgba(167,139,250,0.1);color:var(--purple);">Attachments</div>
              <div class="detail-card-body space-y-2">
                ${d.attachments.map(a => `
                  <a href="${esc(a.url)}" target="_blank" rel="noopener" class="flex items-center gap-2 text-cyan hover:text-white text-sm">
                    <i class="fas fa-paperclip"></i>
                    <span>${esc(a.name || 'Document')}</span>
                    ${a.size ? `<span class="text-muted text-xs">(${Math.round(a.size/1024)} KB)</span>` : ''}
                  </a>
                `).join('')}
              </div>
            </div>` : ''}

            <div class="flex flex-wrap items-end justify-between gap-4 pt-2">
              <div class="text-sm text-muted space-y-1">
                <div>Status: ${statusBadge(d.status)}</div>
                ${d.transportType ? `<div>Transport: <span class="text-white">${esc(d.transportType)}</span></div>` : ''}
                <div>${Number(d.miles || 0).toLocaleString()} miles · $${Number(d.ratePerMile || 0).toFixed(2)}/mi</div>
              </div>
              <div class="text-right">
                <div class="text-xs text-muted uppercase tracking-wider">Total</div>
                <div class="text-3xl font-bold text-orange">$${Number(d.total || d.price || 0).toLocaleString()}</div>
              </div>
            </div>
          `;

          const isAvailable = !d.status || /available|new|posted/i.test(d.status);
          if (isAvailable) {
            actions.innerHTML = `
              <button class="btn btn-ghost" id="detailCloseBtn">Close</button>
              <button class="btn-bid-ex" id="detailBidBtn">$ Bid</button>
              <button class="btn-book-ex" id="detailBookBtn">Book $${Number(d.price || 0).toLocaleString()}</button>
            `;
            document.getElementById('detailCloseBtn')?.addEventListener('click', closeDetailModal);
            document.getElementById('detailBidBtn')?.addEventListener('click', () => {
              closeDetailModal();
              openBidModal(d.id);
            });
            document.getElementById('detailBookBtn')?.addEventListener('click', () => {
              closeDetailModal();
              bookLoad(d.id, d.price);
            });
          } else {
            actions.innerHTML = `<button class="btn btn-ghost" id="detailCloseBtn">Close</button>`;
            document.getElementById('detailCloseBtn')?.addEventListener('click', closeDetailModal);
          }
