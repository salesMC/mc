    function closeDetailModal() {
      document.getElementById('detailModal').classList.add('hidden');
    }

    document.getElementById('closeDetailModal')?.addEventListener('click', closeDetailModal);
    document.getElementById('detailModal')?.addEventListener('click', e => {
      if (e.target.id === 'detailModal') closeDetailModal();
    });

    function openBidModal(id) {
      activeListing = allListings.find(l => l.id === id);
      if (!activeListing) return;

      bidLoadSummary.innerHTML = `
        <div class="font-semibold text-white mb-1">${esc(activeListing.vehicle)}</div>
        <div class="text-sm text-dim">${esc(activeListing.origin.city)}, ${esc(activeListing.origin.state)} → ${esc(activeListing.destination.city)}, ${esc(activeListing.destination.state)}</div>
        <div class="text-sm text-muted mt-1">${Number(activeListing.miles || 0).toLocaleString()} miles · $${Number(activeListing.price).toLocaleString()}</div>
      `;
      bidAmount.value = activeListing.price;
      bidContact.value = '';
      selectedContact = null;
      bidError.classList.add('hidden');
      bidSuccess.classList.add('hidden');
      estimatesLoading.classList.remove('hidden');
      estimatesForm.classList.add('hidden');
      modal.classList.remove('hidden');

      fetch(`/api/exchange/listings/${id}/estimates`)
        .then(r => r.json())
        .then(data => {
          estimatesLoading.classList.add('hidden');
          estimatesForm.classList.remove('hidden');
          pickupEstimate.innerHTML = (data.pickupOptions || []).map(o =>
            `<option value="${esc(o.value)}">${esc(o.label)}</option>`).join('');
          deliveryEstimate.innerHTML = (data.deliveryOptions || []).map(o =>
            `<option value="${esc(o.value)}">${esc(o.label)}</option>`).join('');
        })
        .catch(() => {
          estimatesLoading.innerHTML = '<span class="text-red-400">Could not load estimates.</span>';
        });
    }

    function closeModal() {
      modal.classList.add('hidden');
      activeListing = null;
      contactDropdown.classList.add('hidden');
    }

    function toggleDocsSection() {
      const status = document.getElementById('loadStatus')?.value || '';
      const show = status === 'Delivered' || status === 'Completed';
      document.getElementById('carrierDocsSection')?.classList.toggle('hidden', !show);
    }

    function openLoadModal(id) {
      const load = myLoads.find(l => String(l.id) === String(id));
      if (!load) return;
      activeLoadId = id;
      document.getElementById('loadModalTitle').textContent = 'Update Load ' + (load.listingId || load.listing_id || id);
      document.getElementById('loadModalSub').textContent =
        (load.originCity || load.origin_city || '') + ' → ' + (load.destCity || load.dest_city || '');
      document.getElementById('loadDriver').value = load.driverName || load.driver_name || '';
      document.getElementById('loadPickupEta').value = toInputDate(load.pickupEta || load.pickup_eta);
      document.getElementById('loadDropoffEta').value = toInputDate(load.dropoffEta || load.dropoff_eta);
      document.getElementById('loadStatus').value = normalizeStatus(load.status);
      document.getElementById('loadError').classList.add('hidden');
      document.getElementById('loadInvoice').value = '';
      document.getElementById('loadBol').value = '';
      const inv = load.invoiceUrl || load.invoice_url;
      const bol = load.bolUrl || load.bol_url;
      document.getElementById('loadInvoiceCurrent').innerHTML = inv
        ? `<a href="${esc(inv)}" target="_blank" class="text-cyan hover:text-white"><i class="fas fa-file-invoice mr-1"></i>Current invoice</a>`
        : '';
      document.getElementById('loadBolCurrent').innerHTML = bol
        ? `<a href="${esc(bol)}" target="_blank" class="text-cyan hover:text-white"><i class="fas fa-file-alt mr-1"></i>Current BOL</a>`
        : '';
      toggleDocsSection();
      loadModal.classList.remove('hidden');
    }

    document.getElementById('loadStatus')?.addEventListener('change', toggleDocsSection);

    function readFileAsDataURL(file) {
      return new Promise((resolve, reject) => {
        if (!file) return resolve(null);
        const reader = new FileReader();
        reader.onload = () => resolve({ name: file.name, size: file.size, data: reader.result });
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    function toInputDate(v) {
      if (!v) return '';
      try {
        const d = new Date(v);
        if (isNaN(d.getTime())) return '';
        return d.toISOString().slice(0, 10);
      } catch { return ''; }
    }

    function normalizeStatus(s) {
      const x = (s || 'Booked').toLowerCase();
      if (x.includes('progress')) return 'In Progress';
      if (x.includes('deliver')) return 'Delivered';
      if (x.includes('complete') || x === 'done') return 'Completed';
      if (x.includes('book')) return 'Booked';
      return 'Booked';
    }

    function closeLoadModal() {
      loadModal.classList.add('hidden');
      activeLoadId = null;
    }

    async function bookLoad(id, price) {
      if (!confirm(`Book this load for $${Number(price).toLocaleString()}?`)) return;
      const res = await fetch('/api/exchange/book', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ listingId: id, carrierEmail, amount: Number(price) })
      });
      const data = await res.json();
      if (data.success) {
        alert('Load booked successfully!');
        loadAll();
      } else {
        alert(data.message || 'Booking failed.');
      }
    }

    bidContact.addEventListener('input', () => {
      clearTimeout(contactTimer);
      const q = bidContact.value.trim();
      selectedContact = null;
      if (q.length < 3) { contactDropdown.classList.add('hidden'); return; }
      contactTimer = setTimeout(async () => {
        const res = await fetch(`/api/exchange/contacts?q=${encodeURIComponent(q)}&carrierEmail=${encodeURIComponent(carrierEmail)}`);
        const contacts = await res.json();
        if (!contacts.length) {
          contactDropdown.innerHTML = `<div class="contact-item" data-new="1">Add "${esc(q)}" as new contact</div>`;
        } else {
          contactDropdown.innerHTML = contacts.map(c =>
            `<div class="contact-item" data-name="${esc(c.name)}" data-email="${esc(c.email||'')}" data-phone="${esc(c.phone||'')}">${esc(c.name)}${c.email ? ' — ' + esc(c.email) : ''}</div>`
          ).join('') + `<div class="contact-item" data-new="1">Add "${esc(q)}" as new contact</div>`;
        }
        contactDropdown.classList.remove('hidden');
        contactDropdown.querySelectorAll('.contact-item').forEach(item => {
          item.addEventListener('click', () => {
            if (item.dataset.new) {
              selectedContact = { name: q, email: '', phone: '' };
            } else {
              selectedContact = { name: item.dataset.name, email: item.dataset.email, phone: item.dataset.phone };
              bidContact.value = item.dataset.name;
            }
            contactDropdown.classList.add('hidden');
          });
        });
      }, 300);
    });

    document.getElementById('submitBid').addEventListener('click', async () => {
      bidError.classList.add('hidden');
      bidSuccess.classList.add('hidden');
      const amount = Number(bidAmount.value);
      if (!amount || amount <= 0) {
        bidError.textContent = 'Enter a valid bid amount.';
        bidError.classList.remove('hidden');
        return;
      }
      const contactName = selectedContact?.name || bidContact.value.trim();
      if (!contactName) {
        bidError.textContent = 'Please select or enter a contact.';
        bidError.classList.remove('hidden');
        return;
      }

      const res = await fetch('/api/exchange/bids', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          listingId: activeListing.id,
          carrierEmail,
          amount,
          contactName,
          contactEmail: selectedContact?.email || '',
          contactPhone: selectedContact?.phone || '',
          pickupEstimate: pickupEstimate.value,
          deliveryEstimate: deliveryEstimate.value
        })
      });
      const data = await res.json();
      if (data.success) {
        bidSuccess.textContent = 'Bid placed successfully!';
        bidSuccess.classList.remove('hidden');
        setTimeout(closeModal, 1500);
        loadStats();
      } else {
        bidError.textContent = data.message || 'Failed to place bid.';
        bidError.classList.remove('hidden');
      }
    });

    document.getElementById('saveLoadBtn').addEventListener('click', async () => {
      const err = document.getElementById('loadError');
      err.classList.add('hidden');
      try {
        const status = document.getElementById('loadStatus').value;
        const invFile = document.getElementById('loadInvoice').files?.[0];
        const bolFile = document.getElementById('loadBol').files?.[0];
        const [invoice, bol] = await Promise.all([
          readFileAsDataURL(invFile),
          readFileAsDataURL(bolFile)
        ]);

        const res = await fetch(`/api/exchange/loads/${encodeURIComponent(activeLoadId)}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            carrierEmail,
            driverName: document.getElementById('loadDriver').value.trim(),
            pickupEta: document.getElementById('loadPickupEta').value,
            dropoffEta: document.getElementById('loadDropoffEta').value,
            status,
            invoice: invoice || undefined,
            bol: bol || undefined
          })
        });
        const data = await res.json();
        if (data.success) {
          closeLoadModal();
          loadAll();
        } else {
          err.textContent = data.message || 'Update failed.';
          err.classList.remove('hidden');
        }
      } catch (e) {
        err.textContent = 'Connection error.';
        err.classList.remove('hidden');
      }
    });

    document.getElementById('closeBidModal').addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    document.getElementById('closeLoadModal').addEventListener('click', closeLoadModal);
    loadModal.addEventListener('click', e => { if (e.target === loadModal) closeLoadModal(); });

    function applyFilters() {
      const origin = document.getElementById('filterOrigin').value.toLowerCase();
      const dest = document.getElementById('filterDest').value.toLowerCase();
      const vehicle = document.getElementById('filterVehicle').value.toLowerCase();
      const filtered = allListings.filter(l => {
        const oStr = `${l.origin.city} ${l.origin.state}`.toLowerCase();
        const dStr = `${l.destination.city} ${l.destination.state}`.toLowerCase();
        if (origin && !oStr.includes(origin)) return false;
        if (dest && !dStr.includes(dest)) return false;
        if (vehicle && !(l.vehicle || '').toLowerCase().includes(vehicle)) return false;
        return true;
      });
      renderAvailable(filtered);
    }

    function loadAvailable() {
      const sort = document.getElementById('sortSelect').value;
      return fetch(`/api/exchange/listings?sort=${sort}`)
        .then(r => r.json())
        .then(data => {
          allListings = (data || []).map(l => ({
            ...l,
            postedAgo: timeAgo(l.createdAt)
          }));
          applyFilters();
        })
        .catch(() => renderAvailable([]));
    }

    function loadMyLoads() {
      return fetch(`/api/exchange/loads?email=${encodeURIComponent(carrierEmail)}`)
        .then(r => r.json())
        .then(data => {
          myLoads = data || [];
          let filtered = myLoads;
          if (currentView === 'in_progress') {
            filtered = myLoads.filter(l => /progress/i.test(l.status || ''));
          } else if (currentView === 'delivered') {
            filtered = myLoads.filter(l => /deliver/i.test(l.status || ''));
          } else if (currentView === 'completed') {
            filtered = myLoads.filter(l => /complete|done/i.test(l.status || ''));
          } else if (currentView === 'all') {
            filtered = myLoads;
          }
          renderLoadsTable(filtered);
        })
        .catch(() => renderLoadsTable([]));
    }

    function loadStats() {
      return fetch(`/api/exchange/carrier-stats?email=${encodeURIComponent(carrierEmail)}`)
        .then(r => r.json())
        .then(s => {
          document.getElementById('statAvailable').textContent = s.availableCount ?? allListings.length ?? 0;
          document.getElementById('statInProgress').textContent = s.inProgressCount ?? 0;
          document.getElementById('statDelivered').textContent = s.deliveredCount ?? 0;
          document.getElementById('statCompleted').textContent = s.completedCount ?? 0;
          if (window.updateExchangeNavCounts) {
            window.updateExchangeNavCounts({
              available: s.availableCount ?? allListings.length ?? 0,
              all: s.totalBookings ?? myLoads.length ?? 0,
              in_progress: s.inProgressCount ?? 0,
              delivered: s.deliveredCount ?? 0,
              completed: s.completedCount ?? 0
            });
          }
        })
        .catch(() => {});
    }

    async function loadAll() {
      setViewUI();
      if (currentView === 'available') {
        await loadAvailable();
      } else {
        await loadMyLoads();
      }
      await loadStats();
      // refresh available count even when on other views
      if (currentView !== 'available') {
        fetch('/api/exchange/listings?sort=newest').then(r => r.json()).then(d => {
          allListings = d || [];
          loadStats();
        }).catch(() => {});
      }
    }

    document.getElementById('applyFilterBtn')?.addEventListener('click', applyFilters);
    document.getElementById('resetFilterBtn')?.addEventListener('click', () => {
      document.getElementById('filterOrigin').value = '';
      document.getElementById('filterDest').value = '';
      document.getElementById('filterVehicle').value = '';
      document.getElementById('sortSelect').value = 'newest';
      loadAvailable();
    });
    document.getElementById('sortSelect')?.addEventListener('change', loadAvailable);
    document.getElementById('refreshBtn').addEventListener('click', loadAll);

    document.querySelectorAll('[data-goto]').forEach(el => {
      el.addEventListener('click', (e) => {
        if (e.target.tagName === 'A') return;
        location.href = '/exchange/listings?view=' + el.dataset.goto;
      });
    });

    loadAll();
  })();
  </script>
</body>
</html>
