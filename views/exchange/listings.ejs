              </div>
              <div class="text-right">
                <div class="text-lg font-bold text-orange">$${Number(v.price || d.price || 0).toLocaleString()}</div>
              </div>
            </div>
          `).join('');

          body.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
              <div class="detail-card">
                <div class="detail-card-head">Shipper</div>
                <div class="detail-card-body">
                  <div class="font-semibold text-white mb-1">${dash(shipper.company || shipper.name)}</div>
                  ${shipper.address ? `<div>${esc(shipper.address)}</div>` : ''}
                  ${shipper.phone ? `<div class="mt-1">Phone: <a href="tel:${esc(shipper.phone)}" class="text-cyan hover:text-white">${esc(shipper.phone)}</a></div>` : ''}
                  ${shipper.email ? `<div>Email: <a href="mailto:${esc(shipper.email)}" class="text-cyan hover:text-white">${esc(shipper.email)}</a></div>` : ''}
                  ${!shipper.company && !shipper.name && !shipper.email ? '<div class="text-muted">Shipper details not provided</div>' : ''}
                </div>
              </div>
              <div class="detail-card">
                <div class="detail-card-head cyan">Shipper Contact</div>
                <div class="detail-card-body">
                  <div class="font-semibold text-white mb-1">${dash(sc.name)}</div>
                  ${sc.phone ? `<div>Phone: <a href="tel:${esc(sc.phone)}" class="text-cyan hover:text-white">${esc(sc.phone)}</a></div>` : ''}
                  ${sc.email ? `<div>Email: <a href="mailto:${esc(sc.email)}" class="text-cyan hover:text-white">${esc(sc.email)}</a></div>` : ''}
                  ${!sc.name && !sc.phone && !sc.email ? '<div class="text-muted">No contact on file</div>' : ''}
                </div>
              </div>
              <div class="detail-card">
                <div class="detail-card-head">Pickup Location</div>
                <div class="detail-card-body">
                  <div class="font-semibold text-white mb-1">${dash(pickup.name)}</div>
                  <div>${dash(pickup.address)}</div>
                  ${pickup.contact ? `<div class="mt-2"><span class="text-muted">Contact:</span> ${esc(pickup.contact)}</div>` : ''}
                  ${pickup.phone ? `<div><span class="text-muted">Phone:</span> <a href="tel:${esc(pickup.phone)}" class="text-cyan hover:text-white">${esc(pickup.phone)}</a></div>` : ''}
                  <div class="mt-2"><span class="text-muted">Pickup ETA:</span> <strong>${dash(pickup.eta)}</strong></div>
                  ${pickup.unavailable ? `<div><span class="text-muted">Unavailable:</span> ${esc(pickup.unavailable)}</div>` : ''}
                </div>
              </div>
              <div class="detail-card">
                <div class="detail-card-head cyan">Drop-off Location</div>
                <div class="detail-card-body">
                  <div class="font-semibold text-white mb-1">${dash(dropoff.name)}</div>
                  <div>${dash(dropoff.address)}</div>
                  ${dropoff.contact ? `<div class="mt-2"><span class="text-muted">Contact:</span> ${esc(dropoff.contact)}</div>` : ''}
                  ${dropoff.phone ? `<div><span class="text-muted">Phone:</span> <a href="tel:${esc(dropoff.phone)}" class="text-cyan hover:text-white">${esc(dropoff.phone)}</a></div>` : ''}
                  <div class="mt-2"><span class="text-muted">Drop-off ETA:</span> <strong>${dash(dropoff.eta)}</strong></div>
                  ${dropoff.unavailable ? `<div><span class="text-muted">Unavailable:</span> ${esc(dropoff.unavailable)}</div>` : ''}
                </div>
              </div>
              ${pickup.notes || dropoff.notes ? `
              <div class="detail-card">
                <div class="detail-card-head">Pickup Notes</div>
                <div class="detail-card-body">${pickup.notes ? esc(pickup.notes) : '<span class="text-muted">None</span>'}</div>
              </div>
              <div class="detail-card">
                <div class="detail-card-head cyan">Drop-off Notes</div>
                <div class="detail-card-body">${dropoff.notes ? esc(dropoff.notes) : '<span class="text-muted">None</span>'}</div>
              </div>` : ''}
            </div>

            <div class="detail-card mb-4">
              <div class="detail-card-head" style="background:rgba(190,242,100,0.08);color:var(--lime);">Vehicles</div>
              <div class="detail-card-body py-2">
                ${vehicleHtml || '<div class="text-muted py-3">No vehicle details</div>'}
