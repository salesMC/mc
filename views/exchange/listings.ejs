                ${v.condition ? `<div><span class="text-muted">Condition:</span> ${esc(v.condition)}</div>` : ''}
                ${v.dimensions ? `<div><span class="text-muted">Dimensions:</span> ${esc(v.dimensions)}</div>` : ''}
                ${v.color ? `<div><span class="text-muted">Color:</span> ${esc(v.color)}</div>` : ''}
                ${v.runsAndDrives !== undefined ? `<div><span class="text-muted">Runs & drives:</span> ${v.runsAndDrives ? 'Yes' : 'No'}</div>` : ''}
                ${v.hasKeys !== undefined ? `<div><span class="text-muted">Has keys:</span> ${v.hasKeys ? 'Yes' : 'No'}</div>` : ''}
              </div>
              <div class="text-sm text-dim space-y-0.5">
                ${v.trim ? `<div><span class="text-muted">Trim:</span> ${esc(v.trim)}</div>` : ''}
                ${v.bodySubType ? `<div><span class="text-muted">Body:</span> ${esc(v.bodySubType)}</div>` : ''}
                ${v.gatePass ? `<div><span class="text-muted">Gate pass:</span> ${esc(v.gatePass)}</div>` : ''}
                ${v.modified ? `<div class="text-orange">Modified / custom</div>` : ''}
